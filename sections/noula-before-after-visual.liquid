<section class="noula-section">
  <div class="noula-section__inner">
    <p class="noula-section__eyebrow" style="margin-top: 28px;">{{ section.settings.eyebrow }}</p>
    <h2 class="noula-section__heading">{{ section.settings.heading }}</h2>
    <p class="noula-section__text">{{ section.settings.text }}</p>

    <div class="noula-clean-benefits">
      <div class="noula-clean-row"><span class="noula-clean-dot"></span><span>Looks less tired by morning</span></div>
      <div class="noula-clean-row"><span class="noula-clean-dot"></span><span>Softens dry, dull skin</span></div>
      <div class="noula-clean-row"><span class="noula-clean-dot"></span><span>Rich comfort without greasy residue</span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula benefits clean",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Overnight recovery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Skin that looks fresher by morning."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "One overnight cream for tired-looking skin that needs comfort, moisture and softness while you sleep."
    }
  ],
  "presets": [
    {
      "name": "Noula benefits clean"
    }
  ]
}
{% endschema %}
