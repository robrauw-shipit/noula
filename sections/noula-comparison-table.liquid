<section class="noula-section">
  <div class="noula-section__inner">
    <p class="noula-section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="noula-section__heading">{{ section.settings.heading }}</h2>
    <p class="noula-section__text">{{ section.settings.text }}</p>

    <div class="noula-compare-clean">
      <div class="noula-compare-clean__head">
        <span>Noula</span>
        <span>Regular night creams</span>
      </div>
      <div class="noula-compare-clean__row">
        <span>Built for tired-looking morning skin</span>
        <span>Built for general moisture</span>
      </div>
      <div class="noula-compare-clean__row">
        <span>Fresher, softer, more rested-looking</span>
        <span>Often just richer or heavier</span>
      </div>
      <div class="noula-compare-clean__row">
        <span>Comfort without greasy pillow feel</span>
        <span>Can feel coated by morning</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why it feels different"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the morning after"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Noula focuses on the exact moment she cares about most: waking up to skin that looks fresher, softer and less tired."
    }
  ],
  "presets": [
    {
      "name": "Noula comparison"
    }
  ]
}
{% endschema %}
