<section class="noula-section noula-section--ivory">
  <div class="noula-section__inner">
    <div class="noula-final-offer">
      <div>
        <p class="noula-section__eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="noula-section__heading">{{ section.settings.heading }}</h2>
        <p class="noula-section__text">{{ section.settings.text }}</p>
      </div>
      <div class="noula-final-offer__box">
        <p class="noula-final-offer__label">Best value</p>
        <p class="noula-final-offer__price">2 jars for $49</p>
        <ul class="noula-final-offer__details">
          <li>2x Red Rice Overnight Recovery Cream</li>
          <li>Free Night Routine Kit</li>
          <li>Free shipping</li>
          <li>60-day money-back guarantee</li>
        </ul>
        <a class="noula-final-offer__button" href="#" onclick="event.preventDefault(); document.querySelector('product-info')?.scrollIntoView({ behavior: 'smooth', block: 'start' });">Choose the 2-jar set</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula final offer",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Try Noula risk-free"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start with the 2-Jar Night Recovery Set"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The best-value set is built for consistent nightly use and includes the Night Routine Kit to make the ritual easier from day one."
    }
  ],
  "presets": [
    {
      "name": "Noula final offer"
    }
  ]
}
{% endschema %}
