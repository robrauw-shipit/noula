<section class="noula-section">
  <div class="noula-section__inner">
    <p class="noula-section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="noula-section__heading">{{ section.settings.heading }}</h2>

    <div class="noula-clean-steps">
      <div class="noula-clean-step">
        <span class="noula-clean-step__num">01</span>
        <div>
          <h3>Nourish</h3>
          <p>Red Rice Recovery Complex cushions tired-looking skin.</p>
        </div>
      </div>
      <div class="noula-clean-step">
        <span class="noula-clean-step__num">02</span>
        <div>
          <h3>Comfort</h3>
          <p>Ceramides and humectants support overnight moisture.</p>
        </div>
      </div>
      <div class="noula-clean-step">
        <span class="noula-clean-step__num">03</span>
        <div>
          <h3>Wake</h3>
          <p>Skin looks softer, fresher and more rested by morning.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula how it works clean",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How Noula works overnight"
    }
  ],
  "presets": [
    {
      "name": "Noula how it works clean"
    }
  ]
}
{% endschema %}
