{%- comment -%}
  NOULA LISTICLE — Cocunat skeleton, mobile first (95% of traffic).

  Structure, matching the reference screenshots:
    dark announcement bar -> white header (logo + Shop now)
    -> hero (H1, body, checkmark USPs, black CTA, risk reversal line, image)
    -> 7 numbered reasons, square image LEFT on desktop, alternating band
    -> honest limits -> testimonials -> close -> sticky "See availability"

  ⚠️ LAUNCH GATE: reason 4 states red rice sits near the top of the ingredient
  list. Per noula_listicle_1.md that is a BATCH TWO claim, untrue of batch one.
  Do not publish this page against batch one stock.
{%- endcomment -%}

{%- liquid
  assign cta = section.settings.cta_url
  if cta == blank
    assign cta = '/products/overnight-recovery-cream'
  endif
  assign tick = 'https://cdn.shopify.com/s/files/1/0809/2925/9750/files/check-mark-black-outline.svg?v=1781528042'
-%}

<div class="nlist" data-section-id="{{ section.id }}">
<style>
  .nlist{
    --ink:#1A1A1A;
    --ink-soft:#4A4A4A;
    --line:#E5E0D8;
    --band:#F7F5F1;
    --paper:#FFFFFF;
    --clay:#D2978B;
    --pad:16px;
    font-family:inherit;
    color:var(--ink);
    background:var(--paper);
    -webkit-font-smoothing:antialiased;
  }
  .nlist *,.nlist *::before,.nlist *::after{box-sizing:border-box;font-family:inherit;}
  .nlist img{max-width:100%;display:block;}
  .nlist__wrap{max-width:1180px;margin:0 auto;padding:0 var(--pad);}

  /* ---------- announcement bar ---------- */
  .nlist-ann{
    background:var(--ink);color:#fff;text-align:center;
    padding:9px 16px;font-size:12px;font-weight:700;letter-spacing:.04em;line-height:1.3;
  }

  /* ---------- white header ---------- */
  .nlist-head{
    background:var(--paper);border-bottom:1px solid var(--line);
    position:sticky;top:0;z-index:60;
  }
  .nlist-head__in{
    max-width:1180px;margin:0 auto;padding:12px var(--pad);
    display:flex;align-items:center;justify-content:space-between;gap:16px;
  }
  .nlist-head__logo{height:22px;width:auto;}
  .nlist-head__logo-txt{font-size:19px;font-weight:800;letter-spacing:-.01em;}
  .nlist-head__cta{
    display:inline-flex;align-items:center;justify-content:center;
    background:var(--ink);color:#fff;text-decoration:none;
    padding:9px 18px;border-radius:4px;
    font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;
  }

  /* ---------- hero ---------- */
  .nlist-hero{padding-top:0;padding-bottom:32px;}
  .nlist-hero__grid{display:flex;flex-direction:column;}
  .nlist-hero__media{order:-1;}
  .nlist-hero__h1{margin:0;font-family:var(--font-heading-family,inherit);font-size:25.5px;line-height:1.15;font-weight:800;letter-spacing:-.01em;}
  @media screen and (min-width:390px){.nlist-hero__h1{font-size:28px;}}
  .nlist-hero__stand{margin:14px 0 0;font-size:18px;line-height:1.55;font-weight:400;color:var(--ink);}
  .nlist-hero__media{position:relative;width:calc(100% + var(--pad) * 2);margin:0 calc(var(--pad) * -1) 22px;padding-top:calc(100% + var(--pad) * 2);overflow:hidden;background:var(--band);}
  .nlist-hero__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;}
  .nlist-usps{list-style:none;margin:22px auto 0;padding:0;display:grid;gap:12px;width:max-content;max-width:100%;}
  .nlist-usps li{display:flex;align-items:flex-start;gap:10px;font-size:17px;line-height:1.45;font-weight:700;}
  .nlist-usps img{width:17px;height:17px;flex:0 0 auto;margin-top:2px;}
  .nlist-usps strong{font-weight:700;}
  .nlist-cta{
    display:inline-flex;align-items:center;justify-content:center;
    width:100%;min-height:54px;padding:0 24px;margin-top:22px;
    background:var(--ink);color:#fff;text-decoration:none;border:0;border-radius:0;
    font-size:15px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;
  }
  .nlist-risk{
    margin:12px 0 0;font-size:14.5px;line-height:1.5;color:var(--ink-soft);text-align:center;
  }

  /* ---------- reason ---------- */
  .nlist-reason{padding:28px 0 24px;}
  .nlist-reason--band{background:transparent;}
  .nlist-reason__media{position:relative;width:100%;padding-top:100%;margin:0 0 22px;overflow:hidden;background:var(--band);}
  .nlist-reason__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;}
  .nlist-reason__h2{margin:0 0 14px;font-family:var(--font-heading-family,inherit);font-size:34px;line-height:1.12;font-weight:800;letter-spacing:-.015em;}
  .nlist-reason__body p{margin:0 0 16px;font-size:19px;line-height:1.5;color:var(--ink);}
  .nlist-reason__body p:last-child{margin-bottom:0;}

  /* ---------- testimonials ---------- */
  .nlist-revs{padding:28px 0;border-top:1px solid var(--line);}
  .nlist-revs__title{margin:0 0 18px;font-family:var(--font-heading-family,inherit);font-size:26px;line-height:1.2;font-weight:800;text-align:center;}
  .nlist-rev{border:1px solid var(--line);background:var(--paper);padding:16px;margin-bottom:12px;}
  .nlist-rev:last-child{margin-bottom:0;}
  .nlist-rev__stars{color:#E8A33D;font-size:14px;letter-spacing:1px;line-height:1;}
  .nlist-rev__quote{margin:10px 0 0;font-size:16.5px;line-height:1.55;color:var(--ink);}
  .nlist-rev__foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px;}
  .nlist-rev__name{font-size:14px;font-weight:700;}
  .nlist-rev__badge{
    display:inline-flex;align-items:center;gap:5px;border:1px solid var(--line);border-radius:999px;
    padding:4px 9px;font-size:10.5px;font-weight:700;color:var(--ink-soft);white-space:nowrap;
  }
  .nlist-rev__badge img{width:11px;height:11px;}

  /* ---------- close: product highlight ---------- */
  .nlist-close{background:var(--band);padding-top:32px;padding-bottom:36px;}
  .nlist-close__rating{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:var(--ink-soft);}
  .nlist-close__rating b{color:#E8A33D;font-size:15px;letter-spacing:1px;line-height:1;}
  .nlist-close__title{margin:12px 0 0;font-family:var(--font-heading-family,inherit);font-size:29px;line-height:1.15;font-weight:800;letter-spacing:-.015em;}
  .nlist-close__price{margin:12px 0 0;font-size:15.5px;line-height:1.5;color:var(--ink-soft);}
  .nlist-close .nlist-cta{margin-top:18px;}
  .nlist-close__media{margin:24px auto 0;max-width:340px;}
  .nlist-close__media img{width:100%;height:auto;}
  /* ---------- sticky CTA ---------- */
  .nlist-sticky{
    position:fixed;left:0;right:0;bottom:0;z-index:70;
    background:var(--paper);border-top:1px solid var(--line);
    transform:translateY(110%);transition:transform .25s ease;
    padding:10px var(--pad) calc(10px + env(safe-area-inset-bottom));
  }
  .nlist-sticky.is-on{transform:translateY(0);}
  .nlist-sticky__in{max-width:1180px;margin:0 auto;display:flex;align-items:center;gap:12px;justify-content:flex-end;}
  .nlist-sticky__txt{min-width:0;flex:1;font-size:13px;line-height:1.3;font-weight:700;}
  .nlist-sticky__txt small{display:block;font-weight:500;color:var(--ink-soft);font-size:12px;}
  .nlist-sticky .nlist-cta{margin:0;width:auto;min-height:46px;padding:0 24px;font-size:13px;flex:0 0 auto;}
  @media (prefers-reduced-motion:reduce){.nlist-sticky{transition:none;}}

  /* ---------- desktop ---------- */
  @media screen and (min-width:900px){
    .nlist{--pad:32px;}
    .nlist-ann{font-size:13px;padding:11px 16px;}
    .nlist-head__logo{height:26px;}

    .nlist-hero{padding-top:40px;padding-bottom:48px;}
    .nlist-hero__media{width:100%;margin:0;padding-top:100%;}
    .nlist-hero__grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;}
    .nlist-hero__media{order:0;}
    .nlist-hero__h1{font-size:50px;line-height:1.08;}
    .nlist-hero__stand{font-size:18px;}
    .nlist-hero__media{margin:0;}
    .nlist-cta{width:auto;min-width:340px;}
    .nlist-usps{margin-left:0;}
    .nlist-risk{text-align:left;}

    /* square image LEFT on every reason, per the reference */
    .nlist-reason{padding:0;}
    .nlist-reason__inner{
      display:grid;grid-template-columns:minmax(0,420px) 1fr;gap:56px;align-items:center;
      padding:48px 0;
    }
    .nlist-reason__media{margin:0;}
    .nlist-reason__h2{font-size:38px;}
    .nlist-reason__body p{font-size:19px;}

    .nlist-revs__list{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-items:start;}
    .nlist-rev{margin-bottom:0;}
    .nlist-close{padding-top:56px;padding-bottom:56px;}
    .nlist-close__grid{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center;}
    .nlist-close__title{font-size:42px;}
    .nlist-close__media{margin:0;max-width:none;}
  }
</style>

  <!-- announcement bar -->
  <div class="nlist-ann">{{ section.settings.announcement }}</div>

  <!-- white header -->
  <header class="nlist-head">
    <div class="nlist-head__in">
      <a href="{{ cta }}" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          <img class="nlist-head__logo" src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}">
        {%- else -%}
          <span class="nlist-head__logo-txt">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      <a class="nlist-head__cta" href="{{ cta }}">{{ section.settings.header_cta }}</a>
    </div>
  </header>

  <!-- hero -->
  <div class="nlist__wrap nlist-hero">
    <div class="nlist-hero__grid">
      <div class="nlist-hero__copy">
        <h1 class="nlist-hero__h1">{{ section.settings.h1 }}</h1>
        <p class="nlist-hero__stand">{{ section.settings.standfirst }}</p>

        {%- assign usps = section.settings.usps | newline_to_br | split: '<br />' -%}
        <ul class="nlist-usps">
          {%- for usp in usps -%}
            {%- assign line = usp | strip -%}
            {%- if line != blank -%}
              <li><img src="{{ tick }}" alt="" width="17" height="17">{{ line }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <a class="nlist-cta" href="{{ cta }}">{{ section.settings.cta_text }}</a>
        <p class="nlist-risk">{{ section.settings.risk_reversal }}</p>
      </div>

      {%- if section.settings.hero_image != blank or section.settings.hero_asset != blank -%}
        <figure class="nlist-hero__media">
          {%- if section.settings.hero_image != blank -%}
            {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: section.settings.h1 }}
          {%- else -%}
            <img src="{{ section.settings.hero_asset | asset_url }}" alt="{{ section.settings.h1 | escape }}" width="1000" height="1000">
          {%- endif -%}
        </figure>
      {%- endif -%}
    </div>
  </div>

  <!-- reasons -->
  {%- assign n = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'reason' -%}
      {%- assign n = n | plus: 1 -%}
      {%- assign band = '' -%}
      {%- assign remainder = n | modulo: 2 -%}
      {%- if remainder == 0 -%}{%- assign band = ' nlist-reason--band' -%}{%- endif -%}
      <section class="nlist-reason{{ band }}" {{ block.shopify_attributes }}>
        <div class="nlist__wrap">
          <div class="nlist-reason__inner">
            {%- if block.settings.image != blank or block.settings.asset != blank -%}
              <figure class="nlist-reason__media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.heading }}
                {%- else -%}
                  <img src="{{ block.settings.asset | asset_url }}" loading="lazy" alt="{{ block.settings.heading | escape }}" width="1000" height="1000">
                {%- endif -%}
              </figure>
            {%- endif -%}
            <div class="nlist-reason__copy">
              <h2 class="nlist-reason__h2">{{ n }}. {{ block.settings.heading }}</h2>
              <div class="nlist-reason__body">{{ block.settings.body }}</div>
            </div>
          </div>
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}

  <!-- testimonials -->
  {%- assign revs = section.blocks | where: 'type', 'review' -%}
  {%- if revs.size > 0 -%}
    <section class="nlist-revs">
      <div class="nlist__wrap">
        <h2 class="nlist-revs__title">{{ section.settings.revs_title }}</h2>
        <div class="nlist-revs__list">
          {%- for block in revs -%}
            <article class="nlist-rev" {{ block.shopify_attributes }}>
              <span class="nlist-rev__stars">★★★★★</span>
              <p class="nlist-rev__quote">"{{ block.settings.quote }}"</p>
              <div class="nlist-rev__foot">
                <span class="nlist-rev__name">{{ block.settings.name }}</span>
                <span class="nlist-rev__badge"><img src="{{ tick }}" alt="" width="11" height="11">Verified buyer</span>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <!-- close: product highlight -->
  {%- assign close_product = section.settings.product -%}
  {%- if close_product == blank -%}{%- assign close_product = all_products['overnight-recovery-cream'] -%}{%- endif -%}
  <section class="nlist-close">
    <div class="nlist__wrap">
      <div class="nlist-close__grid">
        <div>
          <p class="nlist-close__rating"><b>★★★★★</b> {{ section.settings.close_rating }}</p>
          <h2 class="nlist-close__title">{{ section.settings.close_title }}</h2>
          {%- if section.settings.close_price != blank -%}<p class="nlist-close__price">{{ section.settings.close_price }}</p>{%- endif -%}
          <a class="nlist-cta" href="{{ cta }}">{{ section.settings.cta_text }}</a>
        </div>
        <figure class="nlist-close__media">
          {%- if section.settings.close_image != blank -%}
            {{ section.settings.close_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: close_product.title }}
          {%- elsif close_product.featured_image != blank -%}
            {{ close_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: close_product.title }}
          {%- endif -%}
        </figure>
      </div>
    </div>
  </section>

  <div style="height:78px" aria-hidden="true"></div>

  <!-- sticky CTA: appears after 20% scroll -->
  <div class="nlist-sticky" data-nlist-sticky>
    <div class="nlist-sticky__in">
      <span class="nlist-sticky__txt">{{ section.settings.sticky_text }}<small>{{ section.settings.sticky_sub }}</small></span>
      <a class="nlist-cta" href="{{ cta }}">{{ section.settings.cta_text }}</a>
    </div>
  </div>
</div>

<script>
  (function(){
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if(!root) return;
    var bar = root.querySelector('[data-nlist-sticky]');
    if(!bar) return;
    var ticking = false;
    function check(){
      ticking = false;
      var doc = document.documentElement;
      var max = (doc.scrollHeight - window.innerHeight) || 1;
      var pct = window.scrollY / max;
      bar.classList.toggle('is-on', pct >= 0.2);
    }
    window.addEventListener('scroll', function(){
      if(ticking) return;
      ticking = true;
      window.requestAnimationFrame(check);
    }, {passive:true});
    check();
  })();
</script>

