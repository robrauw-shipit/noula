<section class="noula-section noula-section--ivory">
  <div class="noula-section__inner noula-stats-strip">
    <div class="noula-section__center">
      <p class="noula-section__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="noula-section__heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="noula-stats-track">
      <div class="noula-stat-card">
        <div class="noula-stat-card__number">94%</div>
        <p class="noula-stat-card__text">said skin felt softer by morning</p>
        <p class="noula-stat-card__note">Placeholder claim. Replace with real survey or remove before launch.</p>
      </div>
      <div class="noula-stat-card">
        <div class="noula-stat-card__number">91%</div>
        <p class="noula-stat-card__text">said skin looked fresher after use</p>
        <p class="noula-stat-card__note">Placeholder claim. Needs substantiation before paid traffic.</p>
      </div>
      <div class="noula-stat-card">
        <div class="noula-stat-card__number">89%</div>
        <p class="noula-stat-card__text">said their face looked more rested</p>
        <p class="noula-stat-card__note">Placeholder claim. Use only after real customer panel.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula real results",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Real results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Designed for better-looking mornings"
    }
  ],
  "presets": [
    {
      "name": "Noula real results"
    }
  ]
}
{% endschema %}
