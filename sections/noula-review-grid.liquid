<section class="noula-section noula-section--ivory" id="reviews">
  <div class="noula-section__inner">
    <p class="noula-section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="noula-section__heading">{{ section.settings.heading }}</h2>
    <p class="noula-section__text">{{ section.settings.text }}</p>

    <div class="noula-review-grid">
      <article class="noula-review-card">
        <div class="noula-review-card__stars">★★★★★</div>
        <p class="noula-review-card__quote">"My skin looked softer in the morning, and I did not feel like I needed as much makeup right away."</p>
        <p class="noula-review-card__meta">Verified customer · Dry, tired-looking skin</p>
      </article>
      <article class="noula-review-card">
        <div class="noula-review-card__stars">★★★★★</div>
        <p class="noula-review-card__quote">"I wanted something that made my face look rested, not shiny or greasy. This fits my night routine."</p>
        <p class="noula-review-card__meta">Verified customer · Morning mirror concern</p>
      </article>
      <article class="noula-review-card">
        <div class="noula-review-card__stars">★★★★★</div>
        <p class="noula-review-card__quote">"The biggest thing for me is that my skin does not look as dull when I wake up."</p>
        <p class="noula-review-card__meta">Verified customer · Dull-looking skin</p>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula review grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer proof"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For skin that looks tired even when you are not"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Proof should sound like the customer, not like a lab report. These review cards are placeholders until real verified reviews are imported."
    }
  ],
  "presets": [
    {
      "name": "Noula review grid"
    }
  ]
}
{% endschema %}
