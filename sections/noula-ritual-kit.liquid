<section class="noula-section noula-section--soft">
  <div class="noula-section__inner">
    <p class="noula-section__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="noula-section__heading">{{ section.settings.heading }}</h2>
    <p class="noula-section__text">{{ section.settings.text }}</p>

    <div class="noula-ritual-list">
      <div class="noula-ritual-item">
        <span class="noula-ritual-item__icon">1</span>
        <div>
          <h3 class="noula-card__title">Soft spa headband</h3>
          <p class="noula-card__text">Keeps hair back during your night routine.</p>
        </div>
      </div>
      <div class="noula-ritual-item">
        <span class="noula-ritual-item__icon">2</span>
        <div>
          <h3 class="noula-card__title">Skincare spatula</h3>
          <p class="noula-card__text">A cleaner way to scoop from the jar.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula ritual kit",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Free with the 2-jar set"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A cleaner night routine"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The 2-jar set includes the small tools that make nightly application feel easier, cleaner and more consistent."
    }
  ],
  "presets": [
    {
      "name": "Noula ritual kit"
    }
  ]
}
{% endschema %}
