{%- comment -%} Noula v2 — before / after {%- endcomment -%}
<section class="nv nv-section nv-section--white" data-section-id="{{ section.id }}">
  <div class="nv-wrap nv-center">
    {%- if section.settings.eyebrow != blank -%}<p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="nv-h2">{{ section.settings.heading | escape | replace: '[[', '<mark>' | replace: ']]', '</mark>' }}</h2>
    {%- if section.settings.lead != blank -%}<p class="nv-lead">{{ section.settings.lead }}</p>{%- endif -%}
    {%- if section.settings.composite -%}
      <div class="nv-ba nv-ba--composite">
        <figure>
          {%- if section.settings.before != blank -%}{{ section.settings.before | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'Before and after' }}
          {%- elsif section.settings.before_url != blank -%}<img src="{{ section.settings.before_url }}" loading="lazy" alt="Before and after">{%- endif -%}
          <figcaption class="nv-ba__cap nv-ba__cap--l">{{ section.settings.before_label }}</figcaption>
          <figcaption class="nv-ba__cap nv-ba__cap--r">{{ section.settings.after_label }}</figcaption>
        </figure>
      </div>
    {%- else -%}
      <div class="nv-ba">
      <figure>
        {%- if section.settings.before != blank -%}{{ section.settings.before | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Before' }}
        {%- elsif section.settings.before_url != blank -%}<img src="{{ section.settings.before_url }}" loading="lazy" alt="Before">{%- endif -%}
        <figcaption>{{ section.settings.before_label }}</figcaption>
      </figure>
      <figure>
        {%- if section.settings.after != blank -%}{{ section.settings.after | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'After' }}
        {%- elsif section.settings.after_url != blank -%}<img src="{{ section.settings.after_url }}" loading="lazy" alt="After">{%- endif -%}
        <figcaption>{{ section.settings.after_label }}</figcaption>
      </figure>
    </div>
    {%- endif -%}
    {%- if section.settings.note != blank -%}<p class="nv-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Noula v2 · Before / after",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real skin, real mornings" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What [[8 weeks]] looks like" },
    { "type": "text", "id": "lead", "label": "Lead" },
    { "type": "checkbox", "id": "composite", "label": "Single composite image (before left, after right)", "default": true },
    { "type": "image_picker", "id": "before", "label": "Before image (or the composite)" },
    { "type": "text", "id": "before_url", "label": "Before URL (fallback)", "default": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/ba_47_v3.jpg" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Before" },
    { "type": "image_picker", "id": "after", "label": "After image" },
    { "type": "text", "id": "after_url", "label": "After URL (fallback)", "default": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/ba_47_v3.jpg" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "After 8 weeks" },
    { "type": "text", "id": "note", "label": "Small print", "default": "Individual results vary. Unretouched, same lighting." }
  ],
  "presets": [{ "name": "Noula v2 · Before / after" }]
}
{% endschema %}
