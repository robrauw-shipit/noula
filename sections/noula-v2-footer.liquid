{%- comment -%} Noula v2 — footer card: logo + newsletter, link columns, help, payments, legal {%- endcomment -%}
<footer class="nv nv-footer" data-section-id="{{ section.id }}">
  <div class="nv-footer__card">
    <div class="nv-footer__top">
      <div class="nv-footer__brand">
        <a class="nv-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: shop.name }}
          {%- elsif settings.logo != blank -%}
            {{ settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', alt: shop.name }}
          {%- else -%}
            <span class="nv-footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="nv-footer__tag">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.show_newsletter -%}
          <div class="nv-footer__newsletter">
            <h3>{{ section.settings.newsletter_heading }}</h3>
            <p>{{ section.settings.newsletter_text }}</p>
            {%- form 'customer', id: 'NvFooterNewsletter', class: 'nv-footer__form-wrap' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="nv-footer__form">
                <input type="email" name="contact[email]" id="NvFooterEmail" value="{{ form.email }}" placeholder="{{ section.settings.newsletter_placeholder }}" aria-label="{{ section.settings.newsletter_placeholder }}" autocorrect="off" autocapitalize="off" autocomplete="email" required>
                <button type="submit" name="commit">{{ section.settings.newsletter_button }}</button>
              </div>
              {%- if form.errors -%}
                <p class="nv-footer__msg nv-footer__msg--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- elsif form.posted_successfully? -%}
                <p class="nv-footer__msg">{{ 'newsletter.success' | t }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'links' and block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
          <div class="nv-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="nv-footer__help">
      {%- if section.settings.help_heading != blank -%}<h4>{{ section.settings.help_heading }}</h4>{%- endif -%}
      {%- if section.settings.help_email != blank -%}
        <p>Email: <a href="mailto:{{ section.settings.help_email }}">{{ section.settings.help_email }}</a></p>
      {%- endif -%}
      {%- if section.settings.help_text != blank -%}<p>{{ section.settings.help_text }}</p>{%- endif -%}

      {%- if section.settings.show_payment -%}
        <div class="nv-footer__pay">
          <span>We accept</span>
          {% render 'noula-v2-payment-icons', class: 'nv-footer__pay-icons' %}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        {%- assign has_social = false -%}
        {%- if settings.social_instagram_link != blank or settings.social_tiktok_link != blank or settings.social_facebook_link != blank or settings.social_youtube_link != blank -%}{%- assign has_social = true -%}{%- endif -%}
        {%- if has_social -%}
          <div class="nv-footer__social">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link | prepend: 'https://' | replace: 'https://https://', 'https://' }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24"><path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9a5.5 5.5 0 0 1-5.5 5.5h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.3-3.3a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <a href="{{ settings.social_tiktok_link | prepend: 'https://' | replace: 'https://https://', 'https://' }}" target="_blank" rel="noopener" aria-label="TikTok">
                <svg viewBox="0 0 24 24"><path d="M16 2h-3v13.2a2.8 2.8 0 1 1-2.8-2.8h.8v-3h-.8A5.8 5.8 0 1 0 16 15.2V9a7.7 7.7 0 0 0 4.5 1.4v-3A4.5 4.5 0 0 1 16 2.9V2Z"/></svg>
              </a>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <a href="{{ settings.social_facebook_link | prepend: 'https://' | replace: 'https://https://', 'https://' }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24"><path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.6 1.6-1.6h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.3H7.4V14h2.8v8h3.3Z"/></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="nv-footer__legal">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a><span>|</span>{%- endif -%}
      {%- endfor -%}
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Noula: Footer",
  "class": "nv-section-footer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (falls back to theme logo)"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Overnight recovery for better-looking mornings."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Be the first to know."
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Text",
      "default": "Sign up for exclusive Noula emails and offers."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button",
      "default": "Submit"
    },
    {
      "type": "header",
      "content": "Need help"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Heading",
      "default": "Need help?"
    },
    {
      "type": "text",
      "id": "help_email",
      "label": "Support email",
      "default": "help@noulaskin.com"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Text",
      "default": "Our support team is here Monday to Friday, 9am to 6pm EST."
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noula: Footer",
      "blocks": [
        {
          "type": "links",
          "settings": {
            "heading": "Shop.",
            "menu": "main-menu"
          }
        },
        {
          "type": "links",
          "settings": {
            "heading": "More.",
            "menu": "footer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
