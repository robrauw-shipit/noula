{%- comment -%} Noula v2 — ingredient cards carousel {%- endcomment -%}
<section class="nv nv-section" data-section-id="{{ section.id }}">
  <div class="nv-wrap">
    <div class="nv-center" style="margin-bottom:28px">
      {%- if section.settings.eyebrow != blank -%}<p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="nv-h2">{{ section.settings.heading | escape | replace: '[[', '<mark>' | replace: ']]', '</mark>' }}</h2>
      {%- if section.settings.lead != blank -%}<p class="nv-lead">{{ section.settings.lead }}</p>{%- endif -%}
    </div>
    <div class="nv-scroller">
      <button class="nv-arrow nv-arrow--prev" type="button" aria-label="Previous"><svg viewBox="0 0 24 24"><path d="m15 5-7 7 7 7"/></svg></button>
      <div class="nv-track">
        {%- for block in section.blocks -%}
          <div class="nv-ing" {{ block.shopify_attributes }}>
            <div class="nv-ing__img">
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- elsif block.settings.image_url != blank -%}<img src="{{ block.settings.image_url }}" loading="lazy" alt="{{ block.settings.name | escape }}">{%- endif -%}
            </div>
            <h3 class="nv-h3">{{ block.settings.name }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
      <button class="nv-arrow nv-arrow--next" type="button" aria-label="Next"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></svg></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula v2 · Ingredients",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "[[Skin-loving]] ingredients" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "The overnight comfort your skin needs when it keeps waking up dry, dull, and tired-looking." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Red Rice Extract" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "K-beauty inspired nourishment for tired-looking skin." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noula v2 · Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Red Rice Extract", "text": "K-beauty inspired nourishment for tired-looking skin.", "image_url": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/ig_017798eba84234ca016a2ff8f929648191b9b9d8d8dd5f53fd.jpg?v=1781529292" } },
        { "type": "ingredient", "settings": { "name": "Ceramides + Vitamin B5", "text": "Comfort dry skin and support the moisture barrier overnight.", "image_url": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/ig_017798eba84234ca016a2ffa2c25c48191a8e775af1e4b7aee.jpg?v=1781529292" } },
        { "type": "ingredient", "settings": { "name": "Hyaluronic Acid", "text": "Draws in moisture for softer, fresher-looking skin by morning.", "image_url": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/ig_017798eba84234ca016a2ff9bdcdbc819191ec302ab8c2b571.jpg?v=1781529291" } }
      ]
    }
  ]
}
{% endschema %}
