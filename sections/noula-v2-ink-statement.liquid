{%- comment -%} 6 · Recognition — ink full bleed, big type, cream text, no product. The scroll stopper. {%- endcomment -%}
<section class="nv nv-section nv-bg-ink" data-section-id="{{ section.id }}">
  <div class="nv-wrap nv-center">
    <div class="nv-statement">
      {%- if section.settings.eyebrow != blank -%}<p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="nv-h2">{{ section.settings.heading | escape | replace: '[[', '<mark>' | replace: ']]', '</mark>' }}</h2>
      {%- if section.settings.text != blank -%}<div class="nv-lead nv-rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Noula: Ink statement",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "((EYEBROW PLACEHOLDER))" },
    { "type": "text", "id": "heading", "label": "Heading (wrap words in [[ ]] for the highlight marker)", "default": "((RECOGNITION HEADLINE — copy pending))" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>((RECOGNITION TEXT — copy pending))</p>" }
  ],
  "presets": [{ "name": "Noula: Ink statement" }]
}
{% endschema %}
