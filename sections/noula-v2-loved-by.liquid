{%- comment -%} Noula v2 — "Loved by 12,000+" review cards carousel {%- endcomment -%}
<section class="nv nv-section nv-section--ivory" data-section-id="{{ section.id }}">
  <div class="nv-wrap">
    <div class="nv-loved__head">
      {%- if section.settings.eyebrow != blank -%}<p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="nv-h2">{{ section.settings.heading | escape | replace: '[[', '<mark>' | replace: ']]', '</mark>' }}</h2>
      {%- if section.settings.lead != blank -%}<p class="nv-lead" style="margin-left:auto;margin-right:auto">{{ section.settings.lead }}</p>{%- endif -%}
    </div>

    <div class="nv-scroller">
      <button class="nv-arrow nv-arrow--prev" type="button" aria-label="Previous"><svg viewBox="0 0 24 24"><path d="m15 5-7 7 7 7"/></svg></button>
      <div class="nv-track">
        {%- for block in section.blocks -%}
          <article class="nv-review" {{ block.shopify_attributes }}>
            <div class="nv-review__img">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- elsif block.settings.image_url != blank -%}
                <img src="{{ block.settings.image_url }}" loading="lazy" alt="{{ block.settings.name | escape }}">
              {%- endif -%}
            </div>
            <div class="nv-review__body">
              <div class="nv-review__meta">
                <span class="nv-review__name">{{ block.settings.name }}{% if block.settings.age != blank %}, {{ block.settings.age }}{% endif %}</span>
                {% render 'noula-v2-stars', rating: block.settings.rating, class: 'nv-stars nv-stars--sm' %}
              </div>
              <span class="nv-review__verified"><svg viewBox="0 0 24 24"><path d="m12 2 2.4 1.9 3-.4.9 2.9 2.7 1.4-.6 3 1.9 2.4-1.9 2.4.6 3-2.7 1.4-.9 2.9-3-.4L12 22l-2.4-1.9-3 .4-.9-2.9L3 16.2l.6-3L1.7 10.8l1.9-2.4-.6-3L5.7 4l.9-2.9 3 .4L12 2Zm-1.2 13.2 5.6-5.6-1.4-1.4-4.2 4.2-2-2-1.4 1.4 3.4 3.4Z"/></svg>Verified purchase</span>
              <p class="nv-review__text">{{ block.settings.text }}</p>
              <button class="nv-review__more" type="button" data-more="Read more" data-less="Read less">Read more</button>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <button class="nv-arrow nv-arrow--next" type="button" aria-label="Next"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></svg></button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula v2 · Loved by",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (wrap a word in [[ ]] to highlight)", "default": "Loved by [[12,000+]]" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "Real women waking up to softer, fresher-looking skin." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_url", "label": "Photo URL (fallback)" },
        { "type": "text", "id": "name", "label": "Name", "default": "Maria" },
        { "type": "text", "id": "age", "label": "Age", "default": "43" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review", "default": "“My skin finally looks rested in the morning, not just moisturized.”" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noula v2 · Loved by",
      "blocks": [
        { "type": "review", "settings": { "name": "Maria", "age": "43", "image_url": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-01.jpg?v=1782119454", "text": "“Over the years I've spent a fortune on night creams. Most did nothing. This is the first one where my skin actually looks rested in the morning, not just moisturized.”" } },
        { "type": "review", "settings": { "name": "Priya", "age": "41", "image_url": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-06.jpg?v=1782119454", "text": "“It feels rich, but never greasy. My skin looks calmer when I wake up and my pillow stays clean.”" } },
        { "type": "review", "settings": { "name": "Dana", "age": "45", "image_url": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-04.jpg?v=1782119454", "text": "“No harsh tingle. Just softer skin that looks less tired by morning. I almost didn't try it — glad I did.”" } },
        { "type": "review", "settings": { "name": "Elena", "age": "44", "image_url": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-02.jpg?v=1782119454", "text": "“I wake up looking fresher, even on mornings when I feel tired. That's all I wanted.”" } }
      ]
    }
  ]
}
{% endschema %}
