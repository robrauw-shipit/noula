{%- comment -%} Noula v2 — "Why Noula is the better choice" closing offer banner {%- endcomment -%}
<section class="nv nv-section" data-section-id="{{ section.id }}">
  <div class="nv-wrap">
    <div class="nv-offer">
      <div class="nv-offer__media">
        {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}
        {%- elsif section.settings.image_url != blank -%}<img src="{{ section.settings.image_url }}" loading="lazy" alt="">{%- endif -%}
      </div>
      <div class="nv-offer__body">
        <h2 class="nv-h2">{{ section.settings.heading | escape | replace: '[[', '<mark>' | replace: ']]', '</mark>' }}</h2>
        <ul class="nv-offer__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {% render 'noula-v2-icon', icon: block.settings.icon %}
              <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
            </li>
          {%- endfor -%}
        </ul>
        {%- if section.settings.cta_text != blank -%}
          <a class="nv-btn" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Noula: Offer banner",
  "max_blocks": 4,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (fallback)",
      "default": "https://cdn.shopify.com/s/files/1/0809/2925/9750/files/model_916_v1.jpg?v=1781526384"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Noula is the better choice"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Claim offer"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "moon",
              "label": "Moon"
            },
            {
              "value": "sun",
              "label": "Sun"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "seal",
              "label": "Seal"
            }
          ],
          "default": "moon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Works overnight"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Softer by morning, more rested over the weeks"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noula: Offer banner",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "icon": "moon",
            "title": "Works overnight",
            "text": "Softer by morning, more rested-looking over the weeks"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "star",
            "title": "Trusted by 12,000+",
            "text": "Loved by women who'd tried everything"
          }
        },
        {
          "type": "point",
          "settings": {
            "icon": "leaf",
            "title": "Gentle",
            "text": "No harsh actives, no overnight peel"
          }
        }
      ]
    }
  ]
}
{% endschema %}
