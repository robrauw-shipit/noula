{%- comment -%} The pink proof — image led, minimal text. {%- endcomment -%}
<section class="nv nv-section nv-bg-{{ section.settings.background }}" data-section-id="{{ section.id }}">
  <div class="nv-wrap">
    <div class="nv-proof">
      <div class="nv-proof__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}
        {%- elsif section.settings.asset != blank -%}
          <img src="{{ section.settings.asset | asset_url }}" loading="lazy" alt="" width="1254" height="1254">
        {%- elsif section.settings.image_url != blank -%}
          <img src="{{ section.settings.image_url }}" loading="lazy" alt="">
        {%- elsif product.featured_image != blank -%}
          {{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title }}
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="nv-h2">{{ section.settings.heading }}</h2>
        <div class="nv-lead nv-rte">{{ section.settings.text }}</div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Noula: Pink proof",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "paper",
          "label": "Paper"
        },
        {
          "value": "cream",
          "label": "Cream"
        }
      ],
      "default": "paper"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL (fallback)"
    },
    {
      "type": "text",
      "id": "asset",
      "label": "Theme asset filename"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The cream itself"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You can see it before you feel it"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Red rice extract gives the cream its colour.</p>"
    }
  ],
  "presets": [
    {
      "name": "Noula: Pink proof"
    }
  ]
}
{% endschema %}
