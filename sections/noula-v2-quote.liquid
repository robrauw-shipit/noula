{%- comment -%} 10 · Lauren — photo left, quote right. PLACEHOLDER until photo + quote are supplied. {%- endcomment -%}
<section class="nv nv-section nv-bg-paper" data-section-id="{{ section.id }}">
  <div class="nv-wrap">
    <div class="nv-quote">
      <div class="nv-quote__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.name }}
        {%- else -%}
          <div class="nv-placeholder nv-placeholder--image">[[ PHOTO PLACEHOLDER — Lauren ]]</div>
        {%- endif -%}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <blockquote>{{ section.settings.quote }}</blockquote>
        {%- if section.settings.name != blank -%}<cite>{{ section.settings.name }}</cite>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Noula: Founder quote",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "[[EYEBROW PLACEHOLDER]]" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "[[LAUREN QUOTE — copy pending]]" },
    { "type": "text", "id": "name", "label": "Attribution", "default": "Lauren, founder" }
  ],
  "presets": [{ "name": "Noula: Founder quote" }]
}
{% endschema %}
