{%- comment -%} Noula v2 — masonry review grid with "show more" {%- endcomment -%}
<section class="nv nv-section nv-bg-paper" data-section-id="{{ section.id }}" data-nv-grid>
  <div class="nv-wrap">
    <div class="nv-center">
      {%- if section.settings.eyebrow != blank -%}<p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="nv-h2">{{ section.settings.heading | escape | replace: '[[', '<mark>' | replace: ']]', '</mark>' }}</h2>
      {%- if section.settings.lead != blank -%}<p class="nv-lead">{{ section.settings.lead }}</p>{%- endif -%}
    </div>
    <div class="nv-grid__meta">
      {% render 'noula-v2-stars', rating: 5 %}
      <span>{{ section.settings.count_text }}</span>
    </div>
    <div class="nv-grid">
      {%- assign limit = section.settings.initial | default: 10 -%}
      {%- for block in section.blocks -%}
        <article class="nv-gcard{% if forloop.index > limit %} is-hidden{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.name }}
          {%- elsif block.settings.image_url != blank -%}<img src="{{ block.settings.image_url }}" loading="lazy" alt="{{ block.settings.name | escape }}">{%- endif -%}
          <div class="nv-gcard__body">
            <div class="nv-gcard__name">{{ block.settings.name }}<svg viewBox="0 0 24 24"><path d="m12 2 2.4 1.9 3-.4.9 2.9 2.7 1.4-.6 3 1.9 2.4-1.9 2.4.6 3-2.7 1.4-.9 2.9-3-.4L12 22l-2.4-1.9-3 .4-.9-2.9L3 16.2l.6-3L1.7 10.8l1.9-2.4-.6-3L5.7 4l.9-2.9 3 .4L12 2Zm-1.2 13.2 5.6-5.6-1.4-1.4-4.2 4.2-2-2-1.4 1.4 3.4 3.4Z"/></svg><small>Verified</small></div>
            {% render 'noula-v2-stars', rating: block.settings.rating, class: 'nv-stars nv-stars--sm' %}
            <p>{{ block.settings.text }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > limit -%}
      <div class="nv-grid__more"><button type="button">Show more reviews</button></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Noula: Review grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Verified buyers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Better mornings [[in a jar]]"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Lead"
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Count text",
      "default": "476 reviews"
    },
    {
      "type": "range",
      "id": "initial",
      "label": "Reviews shown before \"show more\"",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (optional)"
        },
