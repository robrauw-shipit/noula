{%- comment -%} Noula v2 — image + text split (used for "Made to..." and "How does it work?") {%- endcomment -%}
<section class="nv nv-section{% if section.settings.background == 'ivory' %} nv-section--ivory{% elsif section.settings.background == 'white' %} nv-section--white{% endif %}" data-section-id="{{ section.id }}">
  <div class="nv-wrap">
    <div class="nv-split{% if section.settings.image_side == 'right' %} nv-split--img-right{% endif %}">
      <div class="nv-split__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image.alt }}
        {%- elsif section.settings.image_url != blank -%}
          <img src="{{ section.settings.image_url }}" loading="lazy" alt="">
        {%- endif -%}
      </div>
      <div class="nv-split__body">
        {%- if section.settings.eyebrow != blank -%}<p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="nv-h2">{{ section.settings.heading | escape | replace: '[[', '<mark>' | replace: ']]', '</mark>' }}</h2>
        <div class="nv-rte">{{ section.settings.text }}</div>
        {%- if section.blocks.size > 0 -%}
          <ul class="nv-bullets">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'noula-v2-icon', icon: block.settings.icon %}<span>{{ block.settings.text }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>.nv-rte p{margin:0 0 14px;font-size:15.5px;line-height:1.65;color:var(--nv-cocoa-soft)}.nv-rte p:last-child{margin-bottom:0}</style>

{% schema %}
{
  "name": "Noula v2 · Image + text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
    { "type": "select", "id": "image_side", "label": "Image side", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "background", "label": "Background", "options": [ { "value": "bone", "label": "Bone" }, { "value": "ivory", "label": "Ivory" }, { "value": "white", "label": "White" } ], "default": "bone" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (wrap words in [[ ]] to highlight)", "default": "Made for [[tired-looking mornings]]" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Most night creams stop at moisture. Noula is made for the morning mirror moment: dry, dull skin that still looks tired after a full night's sleep.</p><p>Powered by Red Rice Recovery Complex™, ceramides, hyaluronic acid and Vitamin B5, it comforts and nourishes skin overnight so you wake up looking fresher, softer, and more rested.</p>" }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Icon bullet",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "sun", "label": "Sun" }, { "value": "moon", "label": "Moon" }, { "value": "drop", "label": "Drop" }, { "value": "shield", "label": "Shield" },
          { "value": "sparkle", "label": "Sparkle" }, { "value": "clock", "label": "Clock" }, { "value": "layers", "label": "Layers" }, { "value": "face", "label": "Face" },
          { "value": "leaf", "label": "Leaf" }, { "value": "heart", "label": "Heart" }, { "value": "check-circle", "label": "Check" } ], "default": "sparkle" },
        { "type": "text", "id": "text", "label": "Text", "default": "Wakes up dull, tired-looking skin" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noula v2 · Image + text",
      "blocks": [
        { "type": "bullet", "settings": { "icon": "sun", "text": "Wakes up dull, tired-looking skin" } },
        { "type": "bullet", "settings": { "icon": "sparkle", "text": "Softens the look of tired lines" } }
      ]
    }
  ]
}
{% endschema %}
