{%- comment -%} Noula v2 — sticky bottom buy bar (product pages). Shows after the main buy button scrolls out. {%- endcomment -%}
{%- if product -%}
{%- assign REAL_RATING = settings.real_rating | default: 'REAL_RATING' -%}{%- assign REAL_REVIEW_COUNT = settings.real_review_count | default: 'REAL_REVIEW_COUNT' -%}
<div class="nv nv-sticky" data-section-id="{{ section.id }}" data-watch=".product-form__submit">
  <div class="nv-sticky__inner">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 120 | image_tag: class: 'nv-sticky__thumb', loading: 'lazy', alt: product.title }}
    {%- endif -%}
    <div class="nv-sticky__info">
      <div class="nv-sticky__rating">{% render 'noula-v2-stars', rating: 5, class: 'nv-stars nv-stars--sm' %}<span>{{ REAL_RATING }}/5 ({{ REAL_REVIEW_COUNT }} reviews)</span></div>
      <div class="nv-sticky__title">{{ product.title }} <span class="nv-sticky__price">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span></div>
    </div>
    <a class="nv-btn" href="#ProductInfo-{{ section.settings.watch_section_id | default: 'main' }}" data-scroll-to=".product-form__submit">{{ section.settings.cta_text }}</a>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Noula: Sticky buy bar",
  "settings": [
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "watch_section_id",
      "label": "Main product section id",
      "default": "main"
    }
  ],
  "presets": [
    {
      "name": "Noula: Sticky buy bar"
    }
  ]
}
{% endschema %}
