{%- comment -%} Sticky add-to-cart — one button, appears once the title scrolls out of view. {%- endcomment -%}
{%- if product -%}
<div class="nv nv-sticky" data-section-id="{{ section.id }}" data-watch=".nla h1.title">
  <div class="nv-sticky__inner">
    <a class="nv-btn nv-btn--block" href="#ProductInfo-main" data-scroll-to=".product-form__submit">{{ section.settings.cta_text }}</a>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Noula: Sticky add to cart",
  "settings": [
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Add to cart" }
  ],
  "presets": [{ "name": "Noula: Sticky add to cart" }]
}
{% endschema %}
