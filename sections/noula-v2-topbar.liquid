{%- comment -%} 1 · Announcement bar — ink, full width, small caps. Savings figure carries the accent. {%- endcomment -%}
<style>
  .noula-announcement-bar{ position:sticky; top:0; z-index:9999; width:100%; background:var(--noula-ink); color:var(--noula-cream); text-align:center; font-family:var(--noula-body); font-size:13px; font-weight:500; line-height:1.3; padding:12px 16px; letter-spacing:.01em; }
  .noula-announcement-bar strong{ font-weight:800; color:var(--noula-accent); }
  .noula-announcement-bar a{ color:inherit; text-decoration:underline; text-underline-offset:3px; }
</style>
<div class="noula-announcement-bar" data-section-id="{{ section.id }}">
  {{ section.settings.text }}{% if section.settings.highlight != blank %} <strong>{{ section.settings.highlight }}</strong>{% endif %}
  {%- if section.settings.link_text != blank and section.settings.link != blank -%}
    <a href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Noula: Top bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Secret Deal:" },
    { "type": "text", "id": "highlight", "label": "Savings (bold, accent)", "default": "save $66 + Free Gifts" },
    { "type": "text", "id": "link_text", "label": "Link text" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Noula: Top bar" }]
}
{% endschema %}
