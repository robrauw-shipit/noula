{%- comment -%} 7 · What you have already tried — cream. {%- endcomment -%}
<section class="nv nv-section nv-bg-cream" data-section-id="{{ section.id }}">
  <div class="nv-wrap">
    <div class="nv-center">
      {%- if section.settings.eyebrow != blank -%}<p class="nv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="nv-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="nv-lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ul class="nv-tried__list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>{% render 'noula-v2-icon', icon: 'check-circle' %}<div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "Noula: Already tried",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why nothing has worked"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You have already tried the obvious things"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Lead"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Noula: Already tried",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
