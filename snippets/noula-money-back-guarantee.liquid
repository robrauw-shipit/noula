{% comment %}
  Noula Money-Back Guarantee
  Usage in a Custom Liquid block:
  {% render 'noula-money-back-guarantee' %}
{% endcomment %}

<div class="noula-cro noula-guarantee" aria-label="Money-back guarantee">
  <div class="noula-guarantee__seal" aria-hidden="true">
    <svg viewBox="0 0 72 72" role="presentation">
      <circle cx="36" cy="36" r="30" />
      <circle cx="36" cy="36" r="22" fill="none" stroke="currentColor" stroke-width="1.6" opacity=".42" />
      <path d="M36 19.5l3.1 6.25 6.9 1-5 4.85 1.18 6.86L36 35.23l-6.18 3.23L31 31.6l-5-4.85 6.9-1L36 19.5Z" fill="#FBF6F1" />
      <text x="36" y="47" text-anchor="middle" font-size="8.5" font-weight="700" fill="#FBF6F1" font-family="Arial, sans-serif">30 DAYS</text>
    </svg>
  </div>

  <div class="noula-guarantee__content">
    <h3 class="noula-guarantee__title">30-day money-back guarantee</h3>
    <p class="noula-guarantee__copy">
      Try it worry-free. If Noula does not help your skin wake up looking fresher, softer, and more rested, you can get your money back.
    </p>
  </div>
</div>
