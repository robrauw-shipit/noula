{% comment %}
  Noula Stock Meter
  Usage in a Custom Liquid block:
  {% render 'noula-stock-meter' %}
{% endcomment %}

<div class="noula-cro noula-stock-meter" aria-label="Offer availability">
  <p class="noula-stock-meter__title">2-jar deal is moving fast</p>
  <p class="noula-stock-meter__text">Due to high demand, the free Night Routine Kit is included while supplies last.</p>
  <div class="noula-stock-meter__track" aria-hidden="true">
    <span class="noula-stock-meter__fill"></span>
  </div>
  <div class="noula-stock-meter__bottom">
    <span>84% claimed</span>
    <span class="noula-stock-meter__timer">Today only</span>
  </div>
</div>
