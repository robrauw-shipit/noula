{%- comment -%}
  Line icons for Noula v2 sections. Usage: {% render 'noula-v2-icon', icon: 'sun', class: 'nv-icon' %}
{%- endcomment -%}
<span class="{{ class | default: 'nv-icon' }}" aria-hidden="true">
{%- case icon -%}
{%- when 'sun' -%}
<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
{%- when 'moon' -%}
<svg viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
{%- when 'drop' -%}
<svg viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg>
{%- when 'shield' -%}
<svg viewBox="0 0 24 24"><path d="M12 3 4.5 6v5.5c0 4.5 3.2 8 7.5 9.5 4.3-1.5 7.5-5 7.5-9.5V6L12 3Z"/><path d="m9.5 12 1.8 1.8L15 10"/></svg>
{%- when 'sparkle' -%}
<svg viewBox="0 0 24 24"><path d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7Z"/><path d="M19 15c.3 1.8 1 2.5 2.8 2.8-1.8.3-2.5 1-2.8 2.8-.3-1.8-1-2.5-2.8-2.8 1.8-.3 2.5-1 2.8-2.8Z"/></svg>
{%- when 'clock' -%}
<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
{%- when 'layers' -%}
<svg viewBox="0 0 24 24"><path d="M4 9.5c0-1.4 3.6-2.5 8-2.5s8 1.1 8 2.5S16.4 12 12 12 4 10.9 4 9.5Z"/><path d="M4 9.5v5c0 1.4 3.6 2.5 8 2.5s8-1.1 8-2.5v-5"/><path d="M12 12v5"/></svg>
{%- when 'face' -%}
<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M9 10h.01M15 10h.01M8.5 14.5c1 1.2 2.1 1.8 3.5 1.8s2.5-.6 3.5-1.8"/></svg>
{%- when 'check' -%}
<svg viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
{%- when 'check-circle' -%}
<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="m8.5 12.3 2.4 2.4 4.8-5"/></svg>
{%- when 'star' -%}
<svg viewBox="0 0 24 24"><path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L12 16.9l-5.3 2.8 1.1-5.9-4.3-4.1 5.9-.8L12 3.5Z"/></svg>
{%- when 'heart' -%}
<svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-7.5-10A4.2 4.2 0 0 1 12 7.6 4.2 4.2 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z"/></svg>
{%- when 'leaf' -%}
<svg viewBox="0 0 24 24"><path d="M5 19c0-8 4-13 14-14 0 10-5 14-13 14"/><path d="M5 19c3-4 6-7 10-9"/></svg>
{%- when 'seal' -%}
<svg viewBox="0 0 24 24"><path d="m12 2.5 2 1.6 2.5-.4 1 2.4 2.4 1-.4 2.5 1.6 2-1.6 2 .4 2.5-2.4 1-1 2.4-2.5-.4-2 1.6-2-1.6-2.5.4-1-2.4-2.4-1 .4-2.5-1.6-2 1.6-2-.4-2.5 2.4-1 1-2.4 2.5.4 2-1.6Z"/><path d="m8.8 12.2 2.2 2.2 4.4-4.6"/></svg>
{%- when 'jar' -%}
<svg viewBox="0 0 24 24"><rect x="5" y="8" width="14" height="12" rx="3"/><path d="M6 8V6.5A1.5 1.5 0 0 1 7.5 5h9A1.5 1.5 0 0 1 18 6.5V8"/><path d="M9 14h6"/></svg>
{%- when 'truck' -%}
<svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
{%- when 'refresh' -%}
<svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 0 1-13.7 5.6M4 12a8 8 0 0 1 13.7-5.6"/><path d="M17.7 3v3.4h-3.4M6.3 21v-3.4h3.4"/></svg>
{%- when 'wallet' -%}
<svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10h18M16 14.5h2"/></svg>
{%- else -%}
<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/></svg>
{%- endcase -%}
</span>
