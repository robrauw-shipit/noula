{%- comment -%}
  Noula — stock bar + rolling countdown (live-site layout).
  {% render 'noula-v2-stock-bar', title: ..., text: ..., claimed: 89, hours: 12, key: block.id %}
{%- endcomment -%}
<div class="noula-stock-meter">
  <p class="noula-stock-meter__title">{{ title }}</p>
  {%- if text != blank -%}<p class="noula-stock-meter__text">{{ text }}</p>{%- endif -%}
  <div class="noula-stock-meter__track">
    <span class="noula-stock-meter__fill" style="width:{{ claimed }}%;background:linear-gradient(90deg,#E7B4AA,#D2978B);"></span>
  </div>
  <div class="noula-stock-meter__bottom">
    <span>{{ claimed }}% claimed</span>
    <span class="noula-stock-meter__timer" data-nv-countdown data-hours="{{ hours | default: 12 }}" data-key="stock-{{ key }}">Ends in <b data-h>00</b>:<b data-m>00</b>:<b data-s>00</b></span>
  </div>
</div>
