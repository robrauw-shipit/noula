      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  SECTION 15 — FEATURE HIGHLIGHT\n  Self-contained Custom Liquid. Mobile-optimized, theme-font friendly.\n{% endcomment %}\n\n<style>\n  .noula-feat {\n    font-family: inherit;\n    color: #2D241D;\n    padding: 36px 0;\n    border-top: 1px solid #EAE1D2;\n  }\n\n  .noula-feat * {\n    font-family: inherit;\n  }\n\n  .noula-feat__wrap {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 16px;\n  }\n\n  .noula-feat__title {\n    margin: 0;\n    color: #2D241D;\n    font-size: clamp(26px, 7vw, 34px);\n    line-height: 1.12;\n    font-weight: 800;\n    letter-spacing: 0;\n  }\n\n  .noula-feat__hl {\n    display: inline-block;\n    background: #E7B4AA;\n    color: #2D241D;\n    padding: 1px 10px 3px;\n    border-radius: 6px;\n  }\n\n  .noula-feat__p {\n    margin: 15px 0 0;\n    color: #4A3D31;\n    font-size: 15px;\n    line-height: 1.58;\n    letter-spacing: 0;\n  }\n\n  .noula-feat__list {\n    list-style: none;\n    margin: 20px 0 0;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 13px;\n  }\n\n  .noula-feat__list li {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    color: #2D241D;\n    font-size: 15px;\n    font-weight: 700;\n    line-height: 1.35;\n  }\n\n  .noula-feat__icon {\n    width: 38px;\n    height: 38px;\n    border-radius: 50%;\n    flex-shrink: 0;\n    display: block;\n  }\n\n  .noula-feat__img {\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 12px;\n    margin-top: 24px;\n  }\n\n  @media screen and (min-width: 641px) {\n    .noula-feat {\n      padding: 46px 0;\n    }\n\n    .noula-feat__wrap {\n      padding: 0 20px;\n    }\n\n    .noula-feat__title {\n      font-size: 34px;\n      line-height: 1.14;\n      letter-spacing: 0;\n    }\n\n    .noula-feat__p {\n      font-size: 16px;\n      line-height: 1.6;\n    }\n\n    .noula-feat__img {\n      margin-top: 26px;\n    }\n  }\n</style>\n\n<div class=\"noula-feat\">\n  <div class=\"noula-feat__wrap\">\n    <h2 class=\"noula-feat__title\">\n      Recovery that works <span class=\"noula-feat__hl\">while you sleep</span>\n    </h2>\n\n    <p class=\"noula-feat__p\">\n      Most night creams stop at moisture. Noula is made for the morning mirror moment: dry, dull skin that still looks tired after a full night’s sleep.\n    </p>\n\n    <p class=\"noula-feat__p\">\n      Powered by Red Rice Recovery Complex™, ceramides, hyaluronic acid and Vitamin B5, it comforts and nourishes skin overnight so you wake up looking fresher, softer, and more rested.\n    </p>\n\n    <ul class=\"noula-feat__list\">\n      <li>\n        <img\n          class=\"noula-feat__icon\"\n          src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/Frame_33.png?v=1781526850\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n        <span>Wakes up dull, tired-looking skin</span>\n      </li>\n\n      <li>\n        <img\n          class=\"noula-feat__icon\"\n          src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/Frame_34.png?v=1781526850\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n        <span>Softens the look of tired lines</span>\n      </li>\n    </ul>\n\n    <img\n      class=\"noula-feat__img\"\n      src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/model_916_v1.jpg?v=1781526384\"\n      alt=\"Woman applying Noula night cream\"\n      loading=\"lazy\"\n    >\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_LbhTjy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  SECTION 16 — HOW IT WORKS\n  Self-contained Custom Liquid. Mobile-optimized, theme-font friendly.\n{% endcomment %}\n\n<div id=\"how-it-works\" class=\"noula-how\">\n  <div class=\"noula-how__wrap\">\n\n<style>\n  .noula-how {\n    font-family: inherit;\n    color: #2D241D;\n    padding: 36px 0;\n    border-top: 1px solid #EAE1D2;\n  }\n\n  .noula-how * {\n    font-family: inherit;\n  }\n\n  .noula-how__wrap {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 16px;\n  }\n\n  .noula-how__title {\n    margin: 0;\n    color: #2D241D;\n    font-size: clamp(26px, 7vw, 34px);\n    line-height: 1.12;\n    font-weight: 800;\n    letter-spacing: 0;\n  }\n\n  .noula-how__p {\n    margin: 15px 0 0;\n    color: #4A3D31;\n    font-size: 15px;\n    line-height: 1.58;\n    letter-spacing: 0;\n  }\n\n  .noula-how__list {\n    list-style: none;\n    margin: 20px 0 0;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 13px;\n  }\n\n  .noula-how__list li {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    color: #2D241D;\n    font-size: 15px;\n    font-weight: 700;\n    line-height: 1.35;\n  }\n\n  .noula-how__icon {\n    width: 38px;\n    height: 38px;\n    border-radius: 50%;\n    flex-shrink: 0;\n    display: block;\n  }\n\n  @media screen and (min-width: 641px) {\n    .noula-how {\n      padding: 46px 0;\n    }\n\n    .noula-how__wrap {\n      padding: 0 20px;\n    }\n\n    .noula-how__title {\n      font-size: 34px;\n      line-height: 1.14;\n      letter-spacing: 0;\n    }\n\n    .noula-how__p {\n      font-size: 16px;\n      line-height: 1.6;\n    }\n  }\n</style>\n\n<div class=\"noula-how\">\n  <div class=\"noula-how__wrap\">\n    <h2 class=\"noula-how__title\">How does it work?</h2>\n\n    <p class=\"noula-how__p\">\n      Most night creams only sit on top of dry skin. Noula uses Red Rice Recovery Complex™ to comfort skin through the night, when your moisture barrier is most ready for support.\n    </p>\n\n    <p class=\"noula-how__p\">\n      Inspired by Korean beauty rituals, red rice extract pairs with ceramides, hyaluronic acid and Vitamin B5 to help dry, dull skin feel cushioned, hydrated and calm by morning.\n    </p>\n\n    <p class=\"noula-how__p\">\n      No greasy residue. No harsh overnight peel. Just soft, replenished skin that looks like it got the rest you did.\n    </p>\n\n    <ul class=\"noula-how__list\">\n      <li>\n        <img\n          class=\"noula-how__icon\"\n          src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/Frame_11.png?v=1781139084\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n        <span>K-beauty inspired red rice care</span>\n      </li>\n\n      <li>\n        <img\n          class=\"noula-how__icon\"\n          src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/Frame_8.png?v=1781139084\"\n          alt=\"\"\n          loading=\"lazy\"\n        >\n        <span>Comforts the moisture barrier overnight</span>\n      </li>\n    </ul>\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
