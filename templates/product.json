    "custom_liquid_9VELEq": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  SECTION 13 — LOVED BY + REVIEWS CAROUSEL\n  Self-contained Custom Liquid. Theme-font friendly.\n{% endcomment %}\n\n<style>\n  .noula-loved {\n    font-family: inherit;\n    color: #2D241D;\n    line-height: 1.5;\n    padding: 42px 0 12px;\n    border-top: 1px solid #EAE1D2;\n  }\n\n  .noula-loved *,\n  .noula-loved *::before,\n  .noula-loved *::after {\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .noula-loved__head {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 18px;\n    text-align: center;\n  }\n\n  .noula-loved__title {\n    margin: 0;\n    color: #2D241D;\n    font-size: clamp(27px, 7vw, 34px);\n    line-height: 1.12;\n    font-weight: 800;\n    letter-spacing: 0;\n  }\n\n  .noula-loved__circ {\n    position: relative;\n    display: inline-block;\n    white-space: nowrap;\n  }\n\n  .noula-loved__circ svg {\n    position: absolute;\n    left: -9px;\n    top: -5px;\n    width: calc(100% + 18px);\n    height: calc(100% + 10px);\n    overflow: visible;\n    pointer-events: none;\n  }\n\n  .noula-loved__lead {\n    margin: 11px 0 0;\n    color: #6B5C4F;\n    font-size: 14px;\n    line-height: 1.45;\n  }\n\n  .noula-revs-wrap {\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 0;\n  }\n\n  .noula-revs {\n    display: flex;\n    gap: 14px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    padding: 22px 18px 12px !important;\n    margin: 0;\n    scroll-padding-left: 18px;\n    scroll-padding-right: 18px;\n    scrollbar-width: none;\n  }\n\n  .noula-revs::-webkit-scrollbar {\n    display: none;\n  }\n\n  .noula-rev {\n    scroll-snap-align: start;\n    flex: 0 0 calc(84% - 8px);\n    max-width: 360px;\n    overflow: hidden;\n    border: 1px solid #EAE1D2;\n    border-radius: 14px;\n    background: #FFFFFF;\n    box-shadow: 0 8px 24px rgba(45, 36, 29, 0.045);\n  }\n\n  .noula-rev__img {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n    object-position: center center;\n    display: block;\n    background: #F3E8D8;\n  }\n\n  .noula-rev__body {\n    padding: 15px 16px 16px;\n  }\n\n  .noula-rev__top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n  }\n\n  .noula-rev__name {\n    color: #2D241D;\n    font-size: 16px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: 0;\n  }\n\n  .noula-rev__stars {\n    color: #D2978B;\n    letter-spacing: 1px;\n    font-size: 13px;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .noula-rev__verified {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-top: 11px;\n    color: #D2978B;\n    font-size: 11px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n\n  .noula-rev__verified img {\n    width: 15px;\n    height: 15px;\n    display: block;\n    flex-shrink: 0;\n  }\n\n  .noula-rev__quote {\n    margin: 14px 0 0;\n    color: #5F5147;\n    font-size: 14px;\n    line-height: 1.55;\n  }\n\n  .noula-rev__more {\n    background: none;\n    border: 0;\n    padding: 0;\n    width: 100%;\n    cursor: pointer;\n    font-family: inherit;\n    display: block;\n    margin-top: 18px;\n    color: #D2978B;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 800;\n    text-align: center;\n    text-decoration: none;\n  }\n\n  @media screen and (min-width: 750px) {\n    .noula-loved {\n      padding: 46px 0 18px;\n    }\n\n    .noula-loved__head {\n      padding: 0 24px;\n    }\n\n    .noula-loved__lead {\n      font-size: 15px;\n    }\n\n    .noula-revs-wrap {\n      padding: 0 32px;\n    }\n\n    .noula-revs {\n      justify-content: center;\n      gap: 18px;\n      overflow: visible;\n      padding: 26px 0 14px !important;\n    }\n\n    .noula-rev {\n      flex: 1 1 0;\n      max-width: 290px;\n      min-width: 0;\n    }\n\n    .noula-rev__body {\n      padding: 18px 18px 20px;\n    }\n\n    .noula-rev__name {\n      font-size: 17px;\n    }\n\n    .noula-rev__quote {\n      font-size: 14.5px;\n    }\n  }\n\n  @media screen and (min-width: 1200px) {\n    .noula-revs-wrap {\n      padding: 0 48px;\n    }\n\n    .noula-rev {\n      max-width: 300px;\n    }\n  }\n</style>\n\n<div class=\"noula-loved\">\n  <div class=\"noula-loved__head\">\n    <h2 class=\"noula-loved__title\">\n      Loved by\n      <span class=\"noula-loved__circ\">\n        12,000+\n        <svg viewBox=\"0 0 200 70\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n          <ellipse cx=\"100\" cy=\"35\" rx=\"95\" ry=\"30\" fill=\"none\" stroke=\"#D2978B\" stroke-width=\"2.5\" transform=\"rotate(-3 100 35)\" />\n        </svg>\n      </span>\n    </h2>\n    <p class=\"noula-loved__lead\">Real women waking up to softer, fresher-looking skin.</p>\n  </div>\n\n  <div class=\"noula-revs-wrap\">\n    <div class=\"noula-revs\">\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-01.jpg?v=1782119454\" alt=\"Maria, 43\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Maria, 43</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“I'd been using a rich night cream from the drugstore for years and I'd wake up with my skin still tight. About three weeks into Noula I noticed I wasn't reaching for moisturiser the second I got up. My lines are exactly where they were, it hasn't done anything about those.”</p>\n          <button type=\"button\" class=\"noula-rev__more\">Read More</button>\n        </div>\n      </div>\n\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-06.jpg?v=1782119454\" alt=\"Priya, 41\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Priya, 41</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“Heavy creams always ended up on my pillowcase and my face still felt dry by morning, so I'd basically given up on the rich ones. This one absorbs. I checked the pillow the first night. My skin feels calmer, not glowy, just not irritated.”</p>\n          <button type=\"button\" class=\"noula-rev__more\">Read More</button>\n        </div>\n      </div>\n\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-04.jpg?v=1782119454\" alt=\"Dana, 45\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Dana, 45</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“I stopped retinol last year because it stung and gave me flakes along my jaw. I was nervous this would do the same. It doesn't tingle at all and I've used it every night for about five weeks. It won't fix crepiness, my neck is the same, but it's softer.”</p>\n          <button type=\"button\" class=\"noula-rev__more\">Read More</button>\n        </div>\n      </div>\n\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-02.jpg?v=1782119454\" alt=\"Elena, 44\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Elena, 44</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“I moisturise every single night and was still waking up dry. That was the thing. Somewhere around week four I stopped waking up tight. It's not a miracle and I still look my age, which is fine.”</p>\n          <button type=\"button\" class=\"noula-rev__more\">Read More</button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n<script data-noula-more-script>\n  (function(){\n    document.querySelectorAll('.noula-rev').forEach(function(card){\n      var q = card.querySelector('.noula-rev__quote');\n      var b = card.querySelector('.noula-rev__more');\n      if(!q || !b) return;\n      if(q.scrollHeight <= q.clientHeight + 2){ b.style.display='none'; return; }\n      b.addEventListener('click', function(){\n        var open = q.classList.toggle('is-open');\n        b.textContent = open ? 'Read Less' : 'Read More';\n      });\n    });\n  })();\n</script>\n",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_zXPBPg": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  SECTION 14 — BEFORE / AFTER\n  Mobile-first, non-stretched, side-by-side layout.\n{% endcomment %}\n\n<style>\n  .noula-ba {\n    --noula-ba-image: url(\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/ba_47_v3.jpg?v=1781526135\");\n    font-family: inherit;\n    padding: 18px 0;\n  }\n\n  .noula-ba__wrap {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 12px;\n  }\n\n  .noula-ba__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 0;\n    overflow: hidden;\n    border: 1px solid #EAE1D2;\n    border-radius: 12px;\n    background: #F7F0E8;\n    box-shadow: 0 8px 22px rgba(45, 36, 29, 0.07);\n  }\n\n  .noula-ba__panel {\n    position: relative;\n    aspect-ratio: 1 / 2;\n    background-image: var(--noula-ba-image);\n    background-repeat: no-repeat;\n    background-size: 200% auto;\n  }\n\n  .noula-ba__panel--before {\n    background-position: left center;\n  }\n\n  .noula-ba__panel--after {\n    background-position: right center;\n    border-left: 1px solid rgba(255, 255, 255, 0.9);\n  }\n\n  .noula-ba__tag {\n    position: absolute;\n    left: 8px;\n    bottom: 8px;\n    z-index: 2;\n    max-width: calc(100% - 16px);\n    background: rgba(255, 255, 255, 0.94);\n    color: #2D241D;\n    font-size: 9px;\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    white-space: nowrap;\n    padding: 6px 8px;\n    border-radius: 999px;\n    box-shadow: 0 4px 12px rgba(45, 36, 29, 0.12);\n  }\n\n  .noula-ba__panel--after .noula-ba__tag {\n    background: #2D241D;\n    color: #fff;\n  }\n\n  @media screen and (min-width: 641px) {\n    .noula-ba {\n      padding: 24px 0;\n    }\n\n    .noula-ba__wrap {\n      padding: 0 20px;\n    }\n\n    .noula-ba__tag {\n      left: 12px;\n      bottom: 12px;\n      font-size: 11px;\n      padding: 7px 12px;\n    }\n  }\n</style>\n\n<div class=\"noula-ba\">\n  <div class=\"noula-ba__wrap\">\n    <div class=\"noula-ba__grid\" role=\"img\" aria-label=\"Before and after skin results after 4 weeks\">\n      <div class=\"noula-ba__panel noula-ba__panel--before\">\n        <span class=\"noula-ba__tag\">Before</span>\n      </div>\n\n      <div class=\"noula-ba__panel noula-ba__panel--after\">\n        <span class=\"noula-ba__tag\">After 8 weeks</span>\n      </div>\n    </div>\n  </div>\n</div>",
