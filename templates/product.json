        "custom_liquid_VzmrAg": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n  BLOCK 10 — STOCK BAR + COUNTDOWN  (matches noula-stock-meter design-system classes)\n  Rolling 12-hour timer (resets per visitor). Edit labels + claimed % below.\n  • Headline uses Assistant. • Body text inherits your theme/page font.\n  • Fill colour + width are inline so no theme rule can override them.\n{% endcomment %}\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Assistant:wght@600;700;800&display=swap');\n  .noula-stock-meter{display:grid;gap:9px;font-family:inherit;line-height:1.25;margin-top:22px;}\n  .noula-stock-meter__title{margin:0;color:#2D241D;font-family:\"Assistant\",system-ui,sans-serif;font-size:18px;font-weight:600;line-height:1.15;letter-spacing:-.01em;}\n  .noula-stock-meter__text{margin:0;color:rgba(43,31,26,.7);font-size:13px;line-height:1.5;}\n  .noula-stock-meter__track{overflow:hidden;height:10px;border-radius:999px;background:rgba(43,31,26,.08);}\n  .noula-stock-meter__fill{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#E7B4AA,#D2978B);}\n  .noula-stock-meter__bottom{display:flex;justify-content:space-between;gap:12px;color:#2D241D;font-size:13px;font-weight:700;line-height:1.15;}\n  .noula-stock-meter__timer{color:#B5765C;font-variant-numeric:tabular-nums;}\n</style>\n\n<div class=\"noula-stock-meter\">\n  <p class=\"noula-stock-meter__title\">Selling out fast</p>\n  <p class=\"noula-stock-meter__text\">Due to high demand, limited quantities available</p>\n  <div class=\"noula-stock-meter__track\">\n    <span class=\"noula-stock-meter__fill\" style=\"width:89%;background:linear-gradient(90deg,#E7B4AA,#D2978B);\"></span>\n  </div>\n  <div class=\"noula-stock-meter__bottom\">\n    <span>89% claimed</span>\n    <span class=\"noula-stock-meter__timer\">Ends in <span id=\"noula-countdown\">11:59:59</span></span>\n  </div>\n</div>\n\n<script>\n(function(){\n  var cd=document.getElementById('noula-countdown'); if(!cd) return;\n  var KEY='noula_deal_end', end=parseInt(localStorage.getItem(KEY)||'0',10);\n  if(!end||end<Date.now()){end=Date.now()+12*3600*1000;localStorage.setItem(KEY,end);}\n  function tick(){\n    var d=Math.max(0,end-Date.now());\n    var h=String(Math.floor(d/3600000)).padStart(2,'0');\n    var m=String(Math.floor(d%3600000/60000)).padStart(2,'0');\n    var s=String(Math.floor(d%60000/1000)).padStart(2,'0');\n    cd.textContent=h+':'+m+':'+s;\n    if(d<=0){end=Date.now()+12*3600*1000;localStorage.setItem(KEY,end);}\n  }\n  tick(); setInterval(tick,1000);\n})();\n</script>"
          }
        },
