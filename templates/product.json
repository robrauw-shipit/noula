          "settings": {
            "custom_liquid": "{% comment %}\n  NOULA — COMPACT GALLERY THUMBNAILS\n  One row everywhere, ~50% smaller, 6 visible, no arrows, no zoom badge.\n  Left inset matches the theme gutter (1.5rem) so the strip lines up with the\n  main image.\n{% endcomment %}\n\n<style>\n  /* no slider arrows in this gallery — the strip reads as scrollable on its own */\n  #MediaGallery-{{ section.id }} .slider-button,\n  #MediaGallery-{{ section.id }} .slider-buttons{\n    display:none !important;\n  }\n\n  /* no zoom / expand badge over the main image */\n  #MediaGallery-{{ section.id }} .product__media-icon,\n  #MediaGallery-{{ section.id }} .product__media-toggle .svg-wrapper{\n    display:none !important;\n  }\n\n  /* tight gap under the main image */\n  #MediaGallery-{{ section.id }} .thumbnail-slider,\n  #MediaGallery-{{ section.id }} slider-component.thumbnail-slider{\n    margin-top:8px;\n  }\n\n  /* ONE ROW ALWAYS — the theme uses a wrapping grid, which put the thumbs\n     onto a second row on desktop. */\n  #MediaGallery-{{ section.id }} .thumbnail-list{\n    display:flex !important;\n    flex-wrap:nowrap !important;\n    grid-template-columns:none !important;\n    gap:8px;\n    grid-gap:8px;\n    overflow-x:auto;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n    /* 1.5rem = the theme's own gutter, so the strip aligns with the main image */\n    padding-left:1.5rem;\n    padding-right:1.5rem;\n    scroll-padding-left:1.5rem;\n  }\n  #MediaGallery-{{ section.id }} .thumbnail-list::-webkit-scrollbar{\n    display:none;\n  }\n  /* the theme appends a 1.5rem spacer after mobile sliders; not needed here */\n  #MediaGallery-{{ section.id }} .thumbnail-list.slider--mobile:after{\n    content:none;\n  }\n\n  /* six across, so a 5-6 image product shows everything at a glance */\n  #MediaGallery-{{ section.id }} .thumbnail-list__item{\n    flex:0 0 calc((100% - 3rem - 40px) / 6) !important;\n    width:auto !important;\n    max-width:none !important;\n    scroll-snap-align:start;\n  }\n\n  /* thumbs fill their tile cleanly */\n  #MediaGallery-{{ section.id }} .thumbnail{\n    border-radius:8px;\n  }\n  #MediaGallery-{{ section.id }} .thumbnail img{\n    object-fit:cover;\n    width:100%;\n    height:100%;\n  }\n\n  /* desktop: main image has no gutter, so the strip loses it too.\n     overflow stays auto and the slider is width-constrained, otherwise the\n     row escapes the media column and runs across the buy box. */\n  @media screen and (min-width:750px){\n    #MediaGallery-{{ section.id }} .thumbnail-slider,\n    #MediaGallery-{{ section.id }} slider-component.thumbnail-slider{\n      display:block;\n      width:100%;\n      max-width:100%;\n      overflow:hidden;\n    }\n    #MediaGallery-{{ section.id }} .thumbnail-list{\n      padding-left:0;\n      padding-right:0;\n      scroll-padding-left:0;\n      overflow-x:auto;\n      width:100%;\n      max-width:100%;\n    }\n    #MediaGallery-{{ section.id }} .thumbnail-list__item{\n      flex:0 0 calc((100% - 40px) / 6) !important;\n    }\n  }\n\n  /* never let the strip exceed the media column at any width */\n  #MediaGallery-{{ section.id }} .thumbnail-slider,\n  #MediaGallery-{{ section.id }} slider-component.thumbnail-slider{\n    max-width:100%;\n    min-width:0;\n  }\n  .product__media-wrapper{\n    min-width:0;\n  }\n</style>"
