    "custom_liquid_wdUq6B": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  SECTION 18 — COMPARISON TABLE\n  Self-contained Custom Liquid. Compact mobile table.\n{% endcomment %}\n\n<style>\n  .noula-cmp {\n    font-family: inherit;\n    color: #2D241D;\n    padding: 36px 0;\n    border-top: 1px solid #EAE1D2;\n  }\n\n  .noula-cmp * {\n    font-family: inherit;\n  }\n\n  .noula-cmp__wrap {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 16px;\n  }\n\n  .noula-cmp__title {\n    margin: 0 0 18px;\n    text-align: center;\n    color: #2D241D;\n    font-size: 26px;\n    line-height: 1.15;\n    font-weight: 800;\n    letter-spacing: 0;\n  }\n\n  .noula-cmp__box {\n    border: 1px solid #EAE1D2;\n    border-radius: 12px;\n    overflow: hidden;\n    background: #FFFDF9;\n  }\n\n  .noula-cmp__box table {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n  }\n\n  .noula-cmp__box th,\n  .noula-cmp__box td {\n    padding: 14px 8px;\n    text-align: center;\n    border-bottom: 1px solid #EAE1D2;\n    font-size: 13px;\n    line-height: 1.25;\n    vertical-align: middle;\n  }\n\n  .noula-cmp__box th:first-child,\n  .noula-cmp__box td:first-child {\n    width: 58%;\n    text-align: left;\n    color: #6B5C4F;\n    font-size: 12.8px;\n    font-weight: 600;\n    padding-left: 14px;\n  }\n\n  .noula-cmp__box th:nth-child(2),\n  .noula-cmp__box td:nth-child(2) {\n    width: 21%;\n  }\n\n  .noula-cmp__box th:nth-child(3),\n  .noula-cmp__box td:nth-child(3) {\n    width: 21%;\n  }\n\n  .noula-cmp__box thead th {\n    height: 74px;\n    color: #2D241D;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    vertical-align: middle;\n  }\n\n  .noula-cmp__box thead th.is-us {\n    padding: 0;\n    text-align: center;\n    background: #F6E2DC;\n  }\n\n  .noula-cmp__box td.is-us {\n    background: #F6E2DC;\n  }\n\n  .noula-cmp__box tr:last-child td {\n    border-bottom: none;\n  }\n\n  .noula-cmp__logo {\n    width: 60px;\n    height: 60px;\n    display: block;\n    margin: 0 auto;\n    object-fit: contain;\n  }\n\n  .noula-cmp__mark {\n    width: 18px;\n    height: 18px;\n    display: inline-block;\n    object-fit: contain;\n    vertical-align: middle;\n  }\n\n  .noula-cmp__mark--yes {\n    filter: invert(40%) sepia(35%) saturate(700%) hue-rotate(56deg) brightness(88%) contrast(90%);\n  }\n\n  .noula-cmp__mark--no {\n    width: 16px;\n    height: 16px;\n    opacity: 0.7;\n  }\n\n  @media screen and (min-width: 641px) {\n    .noula-cmp {\n      padding: 46px 0;\n    }\n\n    .noula-cmp__wrap {\n      padding: 0 20px;\n    }\n\n    .noula-cmp__title {\n      margin-bottom: 20px;\n      font-size: 26px;\n    }\n\n    .noula-cmp__box th,\n    .noula-cmp__box td {\n      padding: 15px 10px;\n      font-size: 13.5px;\n    }\n\n    .noula-cmp__box th:first-child,\n    .noula-cmp__box td:first-child {\n      font-size: 13px;\n      padding-left: 16px;\n    }\n\n    .noula-cmp__box thead th {\n      height: 78px;\n    }\n\n    .noula-cmp__box thead th.is-us {\n      padding: 0;\n    }\n\n    .noula-cmp__logo {\n      width: 64px;\n      height: 64px;\n    }\n\n    .noula-cmp__mark {\n      width: 20px;\n      height: 20px;\n    }\n\n    .noula-cmp__mark--no {\n      width: 18px;\n      height: 18px;\n    }\n  }\n</style>\n\n<div class=\"noula-cmp\">\n  <div class=\"noula-cmp__wrap\">\n    <h2 class=\"noula-cmp__title\">Why Noula?</h2>\n\n    <div class=\"noula-cmp__box\">\n      <table>\n        <thead>\n          <tr>\n            <th></th>\n            <th class=\"is-us\">\n              <img\n                class=\"noula-cmp__logo\"\n                src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/Frame_2_1.png?v=1780830581\"\n                alt=\"Noula\"\n                loading=\"lazy\"\n              >\n            </th>\n            <th>Others</th>\n          </tr>\n        </thead>\n\n        <tbody>\n          <tr>\n            <td>Targets the morning mirror problem</td>\n            <td class=\"is-us\"><img class=\"noula-cmp__mark noula-cmp__mark--yes\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/check-mark-black-outline.svg?v=1781528042\" alt=\"Yes\" loading=\"lazy\"></td>\n            <td><img class=\"noula-cmp__mark noula-cmp__mark--no\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/cross-23.png?v=1781528045\" alt=\"No\" loading=\"lazy\"></td>\n          </tr>\n\n          <tr>\n            <td>Helps skin look rested, not just moisturized</td>\n            <td class=\"is-us\"><img class=\"noula-cmp__mark noula-cmp__mark--yes\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/check-mark-black-outline.svg?v=1781528042\" alt=\"Yes\" loading=\"lazy\"></td>\n            <td><img class=\"noula-cmp__mark noula-cmp__mark--no\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/cross-23.png?v=1781528045\" alt=\"No\" loading=\"lazy\"></td>\n          </tr>\n\n          <tr>\n            <td>Comforts dry, dull, tired-looking skin</td>\n            <td class=\"is-us\"><img class=\"noula-cmp__mark noula-cmp__mark--yes\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/check-mark-black-outline.svg?v=1781528042\" alt=\"Yes\" loading=\"lazy\"></td>\n            <td><img class=\"noula-cmp__mark noula-cmp__mark--no\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/cross-23.png?v=1781528045\" alt=\"No\" loading=\"lazy\"></td>\n          </tr>\n\n          <tr>\n            <td>Rich cream feel without pillow-grease</td>\n            <td class=\"is-us\"><img class=\"noula-cmp__mark noula-cmp__mark--yes\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/check-mark-black-outline.svg?v=1781528042\" alt=\"Yes\" loading=\"lazy\"></td>\n            <td><img class=\"noula-cmp__mark noula-cmp__mark--no\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/cross-23.png?v=1781528045\" alt=\"No\" loading=\"lazy\"></td>\n          </tr>\n\n          <tr>\n            <td>Recovery support without harsh actives</td>\n            <td class=\"is-us\"><img class=\"noula-cmp__mark noula-cmp__mark--yes\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/check-mark-black-outline.svg?v=1781528042\" alt=\"Yes\" loading=\"lazy\"></td>\n            <td><img class=\"noula-cmp__mark noula-cmp__mark--no\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/cross-23.png?v=1781528045\" alt=\"No\" loading=\"lazy\"></td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 52
      }
    },
    "custom_liquid_pkRcdd": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  SECTION 19 — INGREDIENTS\n  Self-contained Custom Liquid. Premium stacked rows, mobile-first.\n{% endcomment %}\n\n<style>\n  .noula-ing {\n    font-family: inherit;\n    color: #2D241D;\n    padding: 38px 0;\n    border-top: 1px solid #EAE1D2;\n    background: #FFFDF9;\n  }\n\n  .noula-ing * {\n    font-family: inherit;\n  }\n\n  .noula-ing__wrap {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 16px;\n  }\n\n  .noula-ing__title {\n    margin: 0;\n    text-align: center;\n    color: #2D241D;\n    font-size: clamp(27px, 7vw, 34px);\n    line-height: 1.12;\n    font-weight: 800;\n    letter-spacing: 0;\n  }\n\n  .noula-ing__lead {\n    max-width: 520px;\n    margin: 12px auto 0;\n    text-align: center;\n    color: #6B5C4F;\n    font-size: 15px;\n    line-height: 1.55;\n    letter-spacing: 0;\n  }\n\n  .noula-ing__list {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    margin-top: 24px;\n  }\n\n  .noula-ing__card {\n    display: grid;\n    grid-template-columns: 84px 1fr;\n    align-items: center;\n    gap: 14px;\n    border: 1px solid #EAE1D2;\n    border-radius: 14px;\n    background: #FFFFFF;\n    padding: 12px;\n    box-shadow: 0 8px 24px rgba(45, 36, 29, 0.045);\n  }\n\n  .noula-ing__media {\n    width: 84px;\n    height: 84px;\n    border-radius: 10px;\n    background: #F3E8D8;\n    border: 1px solid #EAE1D2;\n    overflow: hidden;\n    flex-shrink: 0;\n  }\n\n  .noula-ing__img {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n  }\n\n  .noula-ing__body {\n    min-width: 0;\n    padding-right: 2px;\n  }\n\n  .noula-ing__name {\n    margin: 0;\n    color: #2D241D;\n    font-size: 18px;\n    line-height: 1.18;\n    font-weight: 800;\n    letter-spacing: 0;\n  }\n\n  .noula-ing__desc {\n    margin: 7px 0 0;\n    color: #5F5147;\n    font-size: 14px;\n    line-height: 1.45;\n    letter-spacing: 0;\n  }\n\n  @media screen and (min-width: 641px) {\n    .noula-ing {\n      padding: 46px 0;\n    }\n\n    .noula-ing__wrap {\n      padding: 0 20px;\n    }\n\n    .noula-ing__title {\n      font-size: 34px;\n      line-height: 1.14;\n    }\n\n    .noula-ing__lead {\n      font-size: 16px;\n      line-height: 1.6;\n    }\n\n    .noula-ing__list {\n      gap: 14px;\n      margin-top: 26px;\n    }\n\n    .noula-ing__card {\n      grid-template-columns: 108px 1fr;\n      gap: 18px;\n      padding: 14px 18px 14px 14px;\n    }\n\n    .noula-ing__media {\n      width: 108px;\n      height: 108px;\n      border-radius: 12px;\n    }\n\n    .noula-ing__name {\n      font-size: 20px;\n    }\n\n    .noula-ing__desc {\n      font-size: 14.5px;\n    }\n  }\n</style>\n\n<div class=\"noula-ing\">\n  <div class=\"noula-ing__wrap\">\n    <h2 class=\"noula-ing__title\">Ingredients for better-looking mornings</h2>\n\n    <p class=\"noula-ing__lead\">\n      The overnight comfort your skin needs when it keeps waking up dry, dull, and tired-looking.\n    </p>\n\n    <div class=\"noula-ing__list\">\n      <div class=\"noula-ing__card\">\n        <div class=\"noula-ing__media\">\n          <img\n            class=\"noula-ing__img\"\n            src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/ig_017798eba84234ca016a2ff8f929648191b9b9d8d8dd5f53fd.jpg?v=1781529292\"\n            alt=\"Red Rice Extract\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"noula-ing__body\">\n          <h3 class=\"noula-ing__name\">Red Rice Extract</h3>\n          <p class=\"noula-ing__desc\">K-beauty inspired nourishment for tired-looking skin</p>\n        </div>\n      </div>\n\n      <div class=\"noula-ing__card\">\n        <div class=\"noula-ing__media\">\n          <img\n            class=\"noula-ing__img\"\n            src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/ig_017798eba84234ca016a2ffa2c25c48191a8e775af1e4b7aee.jpg?v=1781529292\"\n            alt=\"Ceramides and Vitamin B5\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"noula-ing__body\">\n          <h3 class=\"noula-ing__name\">Ceramides + Vitamin B5</h3>\n          <p class=\"noula-ing__desc\">Comfort dry skin and support the moisture barrier</p>\n        </div>\n      </div>\n\n      <div class=\"noula-ing__card\">\n        <div class=\"noula-ing__media\">\n          <img\n            class=\"noula-ing__img\"\n            src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/ig_017798eba84234ca016a2ff9bdcdbc819191ec302ab8c2b571.jpg?v=1781529291\"\n            alt=\"Hyaluronic Acid\"\n            loading=\"lazy\"\n          >\n        </div>\n\n        <div class=\"noula-ing__body\">\n          <h3 class=\"noula-ing__name\">Hyaluronic Acid</h3>\n          <p class=\"noula-ing__desc\">Draws in moisture for softer, fresher-looking skin</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 52
      }
    },
    "custom_liquid_wall": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  SECTION 20 — REVIEW WALL (masonry, Loox style)\n  Self-contained Custom Liquid. Matches the Noula design system.\n{% endcomment %}\n\n<style>\n  .noula-wall{font-family:inherit;color:#2D241D;padding:42px 0 12px;border-top:1px solid #EAE1D2;}\n  .noula-wall *{font-family:inherit;box-sizing:border-box;}\n  .noula-wall__wrap{max-width:1040px;margin:0 auto;padding:0 16px;}\n  .noula-wall__head{text-align:center;margin:0 0 6px;}\n  .noula-wall__title{margin:0;font-size:clamp(25px,6.5vw,32px);line-height:1.15;font-weight:800;}\n  .noula-wall__meta{display:flex;align-items:center;justify-content:center;gap:8px;margin:10px 0 22px;font-size:14px;color:#6B5C4F;}\n  .noula-wall__meta b{color:#D2978B;font-size:15px;letter-spacing:1px;line-height:1;}\n  .noula-wall__grid{columns:2;column-gap:10px;}\n  .noula-wall__card{break-inside:avoid;margin:0 0 10px;background:#FFFFFF;border:1px solid #EAE1D2;border-radius:12px;overflow:hidden;}\n  .noula-wall__card.is-hidden{display:none;}\n  .noula-wall__card > img{width:100%;height:auto;display:block;}\n  .noula-wall__body{padding:13px 13px 15px;}\n  .noula-wall__top{display:flex;align-items:center;gap:5px;}\n  .noula-wall__name{font-size:13.5px;font-weight:800;line-height:1.25;}\n  .noula-wall__badge{width:14px !important;height:14px !important;min-width:14px;max-width:14px;display:block;flex-shrink:0;object-fit:contain;}\n  .noula-wall__stars{display:block;margin:6px 0 0;color:#D2978B;font-size:13px;letter-spacing:1px;line-height:1;}\n  .noula-wall__quote{margin:8px 0 0;font-size:13.5px;line-height:1.5;color:#5F5147;}\n  .noula-wall__place{display:block;margin:9px 0 0;font-size:11.5px;color:#6B5C4F;}\n  .noula-wall__more{text-align:center;margin:18px 0 0;}\n  .noula-wall__more button{background:#FFFFFF;border:1px solid #2D241D;border-radius:999px;padding:13px 24px;font-family:inherit;font-size:14px;font-weight:700;color:#2D241D;cursor:pointer;}\n  @media screen and (min-width:750px){\n    .noula-wall{padding:52px 0 18px;}\n    .noula-wall__wrap{padding:0 24px;}\n    .noula-wall__grid{columns:3;column-gap:12px;}\n    .noula-wall__card{margin-bottom:12px;}\n  }\n  @media screen and (min-width:1000px){ .noula-wall__grid{columns:4;} }\n</style>\n\n<section class=\"noula-wall\" id=\"reviews\">\n  <div class=\"noula-wall__wrap\">\n    <div class=\"noula-wall__head\">\n      <h2 class=\"noula-wall__title\">What women are saying</h2>\n      <p class=\"noula-wall__meta\"><b>★★★★★</b> 4.8/5 · 476+ reviews</p>\n    </div>\n    <div class=\"noula-wall__grid\">\n        <article class=\"noula-wall__card\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Cheryl A., 57</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">My neck was the thing. Crumpled, like tissue paper, and every cream just sat on it. First fortnight I thought nothing was happening. Around week five my husband asked if I'd done something. It's softer. It's not a new neck and I'm still 57.</p>\n            <span class=\"noula-wall__place\">Burlington, VT</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Marianne T., 56</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">I'd got to the point of accepting this was just my skin now. Used it eight weeks. The tightness in the morning has gone, which I did not expect. Everything else is the same and honestly that's fine.</p>\n            <span class=\"noula-wall__place\">Boise, ID</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card\">\n          <img src=\"{{ 'noula-selfie-1.jpg' | asset_url }}\" alt=\"Dawn R., 54\" loading=\"lazy\" width=\"1000\" height=\"1000\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Dawn R., 54</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">I have a shelf of half-used jars, including one that cost more than this. Three weeks in, the difference is I don't wake up and immediately want to put something on my face. That's the whole review. First thing in four years that did anything.</p>\n            <span class=\"noula-wall__place\">Grand Rapids, MI</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card\">\n          <img src=\"{{ 'noula-selfie-3.jpg' | asset_url }}\" alt=\"Denise K., 53\" loading=\"lazy\" width=\"1000\" height=\"1000\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Denise K., 53</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">I'm on HRT and it sorted a lot of things out. It did not stop my face feeling tight every morning. This goes on top of everything else and the tightness is mostly gone. I can't tell you why it works when the expensive stuff didn't.</p>\n            <span class=\"noula-wall__place\">Columbus, OH</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Yolanda P., 52</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">Retinol wrecked me last year, stinging and flaking along the jaw, so I stopped. This doesn't sting at all. Week six and my skin feels like skin in the morning. It hasn't touched my lines and I wasn't expecting it to.</p>\n            <span class=\"noula-wall__place\">Tucson, AZ</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card\">\n          <img src=\"{{ 'noula-selfie-5.jpg' | asset_url }}\" alt=\"Sharon B., 51\" loading=\"lazy\" width=\"1000\" height=\"1000\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Sharon B., 51</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">I moisturise like crazy and was still waking up dry, which never made sense to me. Three weeks in, that stopped. Not dramatic. Just not dry.</p>\n            <span class=\"noula-wall__place\">Louisville, KY</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Michelle K., 51</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">My skin fell off a cliff at 49 and nothing since has worked the way it used to. This is the first one where I've kept using it past the first jar. It's comfort, not a transformation, and at this point comfort is what I want.</p>\n            <span class=\"noula-wall__place\">Madison, WI</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Robin S., 50</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">I use tretinoin twice a week and my derm had no issue with this alongside it. On the nights the tretinoin is too much, this is what I put on. Nothing clashes.</p>\n            <span class=\"noula-wall__place\">Portland, ME</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <img src=\"{{ 'noula-selfie-2.jpg' | asset_url }}\" alt=\"Angela M., 49\" loading=\"lazy\" width=\"1000\" height=\"1000\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Angela M., 49</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">Everything gentle did nothing and everything strong hurt. That was my whole experience of the last five years. This one is gentle and something still happens, which I didn't think was possible.</p>\n            <span class=\"noula-wall__place\">Naperville, IL</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Frances D., 58</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">Crepey on the tops of my cheeks, the bit no one warns you about. Five weeks and it's less papery. Not gone. I'm not trying to look 25, I just wanted it to feel like skin.</p>\n            <span class=\"noula-wall__place\">Asheville, NC</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Patrice L., 55</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">The pillowcase test sold me. Rich creams always ended up on the linen and my face was dry anyway. This one's gone by the time I'm asleep.</p>\n            <span class=\"noula-wall__place\">Savannah, GA</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <img src=\"{{ 'noula-selfie-4.jpg' | asset_url }}\" alt=\"Karen W., 53\" loading=\"lazy\" width=\"1000\" height=\"1000\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Karen W., 53</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">Bought it expecting to be disappointed again. Used the whole jar because of the 90 nights. I'd say week four is when I noticed, and what I noticed is an absence, I stopped thinking about my skin before coffee.</p>\n            <span class=\"noula-wall__place\">Spokane, WA</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Jo-Ann R., 47</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">Perimenopause hit and my skin went from oily to parched in about a year. This is the only thing that's held overnight. My texture is still my texture.</p>\n            <span class=\"noula-wall__place\">Manchester, NH</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Lynette H., 60</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">At 60 I've stopped believing claims. Two months in, my face is comfortable in the morning instead of tight. That's a small thing and it's the only thing I wanted.</p>\n            <span class=\"noula-wall__place\">Bend, OR</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Bernadette C., 54</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">Sensitive skin that reacts to things that never bothered me before. No sting, no bumps, nothing. Used it every night for seven weeks.</p>\n            <span class=\"noula-wall__place\">Rochester, NY</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Diane F., 56</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">I'd spent a fortune on the fancy jars and got nothing. This is under sixty dollars and it's the one that did something. Make of that what you will.</p>\n            <span class=\"noula-wall__place\">Fort Collins, CO</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-01.jpg?v=1782119454\" alt=\"Maria, 43\" loading=\"lazy\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Maria, 43</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">I'd been using a rich night cream from the drugstore for years and I'd wake up with my skin still tight. About three weeks into Noula I noticed I wasn't reaching for moisturiser the second I got up. My lines are exactly where they were, it hasn't done anything about those.</p>\n            <span class=\"noula-wall__place\">Verified buyer</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-06.jpg?v=1782119454\" alt=\"Priya, 41\" loading=\"lazy\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Priya, 41</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">Heavy creams always ended up on my pillowcase and my face still felt dry by morning, so I'd basically given up on the rich ones. This one absorbs. I checked the pillow the first night. My skin feels calmer, not glowy, just not irritated.</p>\n            <span class=\"noula-wall__place\">Verified buyer</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-04.jpg?v=1782119454\" alt=\"Dana, 45\" loading=\"lazy\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Dana, 45</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">I stopped retinol last year because it stung and gave me flakes along my jaw. I was nervous this would do the same. It doesn't tingle at all and I've used it every night for about five weeks. It won't fix crepiness, my neck is the same, but it's softer.</p>\n            <span class=\"noula-wall__place\">Verified buyer</span>\n          </div>\n        </article>\n        <article class=\"noula-wall__card is-hidden\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-02.jpg?v=1782119454\" alt=\"Elena, 44\" loading=\"lazy\">\n          <div class=\"noula-wall__body\">\n            <div class=\"noula-wall__top\">\n              <span class=\"noula-wall__name\">Elena, 44</span>\n              <img class=\"noula-wall__badge\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\" width=\"14\" height=\"14\">\n            </div>\n            <span class=\"noula-wall__stars\">★★★★★</span>\n            <p class=\"noula-wall__quote\">I moisturise every single night and was still waking up dry. That was the thing. Somewhere around week four I stopped waking up tight. It's not a miracle and I still look my age, which is fine.</p>\n            <span class=\"noula-wall__place\">Verified buyer</span>\n          </div>\n        </article>\n    </div>\n    <div class=\"noula-wall__more\"><button type=\"button\">Show more reviews</button></div>\n  </div>\n</section>\n\n<script>\n  (function(){\n    var wall = document.querySelector('.noula-wall');\n    if(!wall) return;\n    var btn = wall.querySelector('.noula-wall__more button');\n    if(!btn) return;\n    btn.addEventListener('click', function(){\n      wall.querySelectorAll('.noula-wall__card.is-hidden').forEach(function(c){ c.classList.remove('is-hidden'); });\n      wall.querySelector('.noula-wall__more').style.display = 'none';\n    });\n  })();\n</script>\n",
