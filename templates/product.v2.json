          }
        },
        "custom_liquid_KDDpqG": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n  BLOCK 12 — QUICK FAQ (accordion)\n  Self-contained: styles + markup + JS. Theme-font friendly.\n{% endcomment %}\n\n<style>\n  .nla {\n    --clay: #B5765C;\n    --cocoa: #2D241D;\n    --line: #EAE1D2;\n    font-family: inherit;\n    color: var(--cocoa);\n    line-height: 1.6;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .nla * {\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .nla.blk {\n    margin-top: 22px;\n  }\n\n  .nla .acc .item {\n    border-bottom: 1px solid var(--line);\n  }\n\n  .nla .acc .item:first-child {\n    border-top: 1px solid var(--line);\n  }\n\n  .nla .acc .q {\n    width: 100%;\n    background: none;\n    border: none;\n    text-align: left;\n    color: var(--cocoa);\n    font-size: 18px;\n    line-height: 1.35;\n    font-weight: 600;\n    letter-spacing: 0;\n    padding: 18px 38px 18px 0;\n    cursor: pointer;\n    position: relative;\n  }\n\n  .nla .acc .q::after {\n    content: \"+\";\n    position: absolute;\n    right: 4px;\n    top: 50%;\n    transform: translateY(-50%);\n    color: var(--clay);\n    font-size: 24px;\n    line-height: 1;\n    font-weight: 400;\n  }\n\n  .nla .acc .item.open .q::after {\n    content: \"–\";\n  }\n\n  .nla .acc .a {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.3s ease;\n  }\n\n  .nla .acc .a .inner {\n    padding: 0 0 18px;\n    color: #4A3D31;\n    font-size: 14.5px;\n    line-height: 1.55;\n    letter-spacing: 0;\n  }\n</style>\n\n<div class=\"nla blk\">\n  <div class=\"acc\">\n    <div class=\"item\">\n      <button type=\"button\" class=\"q\">What makes it different?</button>\n      <div class=\"a\"><div class=\"inner\">Most night creams just sit on the surface. Noula's Red Rice Recovery Complex targets the look of tired, depleted skin — restoring the overnight nourishment skin loses with age, so you wake up looking rested, not just moisturised.</div></div>\n    </div>\n\n    <div class=\"item\">\n      <button type=\"button\" class=\"q\">Does it work on my skin?</button>\n      <div class=\"a\"><div class=\"inner\">Yes. Noula is formulated for all skin types, including sensitive and reactive skin. It's fragrance-light, non-greasy, and comfortable to wear every night.</div></div>\n    </div>\n\n    <div class=\"item\">\n      <button type=\"button\" class=\"q\">How do I use it?</button>\n      <div class=\"a\"><div class=\"inner\">As the last step of your evening routine, smooth a small amount over cleansed skin. It absorbs fully overnight — no residue on your pillow.</div></div>\n    </div>\n\n    <div class=\"item\">\n      <button type=\"button\" class=\"q\">How does the guarantee work?</button>\n      <div class=\"a\"><div class=\"inner\">Sleep on it for 90 nights. If you don't look more rested, contact us for a full refund — keep the jar.</div></div>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    document.querySelectorAll('.nla .acc').forEach(function (acc) {\n      acc.querySelectorAll('.item .q').forEach(function (q) {\n        q.addEventListener('click', function () {\n          var item = q.parentElement;\n          var a = item.querySelector('.a');\n          var open = item.classList.contains('open');\n\n          acc.querySelectorAll('.item').forEach(function (i) {\n            i.classList.remove('open');\n            i.querySelector('.a').style.maxHeight = null;\n          });\n\n          if (!open) {\n            item.classList.add('open');\n            a.style.maxHeight = a.scrollHeight + 'px';\n          }\n        });\n      });\n    });\n  })();\n</script>"
          }
        },
