        "custom_liquid_hyAKDc": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}\n  BLOCK 04 — TITLE + PRICE\n  Correct Shopify pricing display:\n  - Compare-at price = old/struck-through price\n  - Variant price = current/main price\n  - No decimals\n  - Uses theme font\n{% endcomment %}\n\n{% assign current_variant = product.selected_or_first_available_variant %}\n{% assign current_price = current_variant.price %}\n{% assign current_compare_at_price = current_variant.compare_at_price %}\n\n<style>\n  .nla{\n    --cocoa:#2D241D;\n    --sale-red:#C43A2F;\n    --white:#FFFFFF;\n    font-family:inherit;\n    color:var(--cocoa);\n    line-height:1.6;\n    -webkit-font-smoothing:antialiased;\n  }\n\n  .nla,\n  .nla *{\n    box-sizing:border-box;\n    font-family:inherit;\n  }\n\n  .nla.blk{\n    margin-top:0 !important;\n    padding-top:0 !important;\n  }\n\n  .nla h1{\n    font-weight:700;\n    margin:0;\n  }\n\n  .nla h1.title{\n    font-size:33px;\n    margin:12px 0 16px !important;\n    padding-top:0 !important;\n    line-height:1.05;\n    letter-spacing:-.03em;\n    white-space:nowrap;\n  }\n\n  @media(max-width:420px){\n    .nla h1.title{\n      font-size:28px;\n    }\n  }\n\n  @media(max-width:360px){\n    .nla h1.title{\n      font-size:25px;\n      white-space:normal;\n    }\n  }\n\n  .nla .pricerow{\n    display:flex;\n    align-items:center;\n    gap:9px;\n    flex-wrap:wrap;\n    line-height:1;\n  }\n\n  .nla .old-price{\n    display:inline-flex !important;\n    align-items:center;\n    font-size:21px;\n    font-weight:500;\n    color:var(--sale-red);\n    text-decoration-line:line-through;\n    text-decoration-thickness:1.5px;\n    text-decoration-color:var(--sale-red);\n  }\n\n  .nla .main-price{\n    display:inline-flex;\n    align-items:center;\n    font-size:24px;\n    font-weight:800;\n    color:#111;\n    letter-spacing:-.02em;\n  }\n\n  .nla .badge{\n    display:inline-flex;\n    align-items:center;\n    background:#2C251E;\n    color:#fff;\n    font-size:10px;\n    font-weight:800;\n    letter-spacing:.04em;\n    padding:5px 7px;\n    border-radius:6px;\n    text-transform:uppercase;\n    line-height:1;\n  }\n</style>\n\n<div class=\"nla blk\">\n\n  <h1 class=\"title\">{{ product.title }}</h1>\n\n  <div class=\"pricerow\">\n\n    {% if current_compare_at_price > current_price %}\n      <s class=\"old-price variant-item__old-price\">\n        {{ current_compare_at_price | money_without_trailing_zeros }}\n      </s>\n    {% endif %}\n\n    <span class=\"main-price\" id=\"price\">\n      {{ current_price | money_without_trailing_zeros }}\n    </span>\n\n    <span class=\"badge\">\n      Bestseller\n    </span>\n\n  </div>\n\n</div>"
          }
        },
        "custom_liquid_nQNyfU": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign customer_country = localization.country.iso_code | default: '' | upcase %}\n\n{% if customer_country == 'US' %}\n  <div class=\"custom-shop-pay-line\">\n    or 2 interest-free payments of\n    <strong class=\"custom-shop-pay-installment\">$0.00</strong>\n    with\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0864/5165/0895/files/Shop_Pay_logo_svg.png?v=1781252724\"\n      alt=\"Shop Pay\"\n      class=\"custom-shop-pay-logo\"\n    >\n  </div>\n\n  <script>\n    document.addEventListener('DOMContentLoaded', function () {\n      function parsePrice(text) {\n        return Number(text.replace(/[^0-9.,]/g, '').replace(',', '.'));\n      }\n\n      function updateShopPayInstallment() {\n        var mainPrice = document.querySelector('.pricerow .main-price, #price');\n        var installmentEl = document.querySelector('.custom-shop-pay-installment');\n\n        if (!mainPrice || !installmentEl) return;\n\n        var price = parsePrice(mainPrice.textContent);\n        if (!price || Number.isNaN(price)) return;\n\n        var installment = price / 2;\n\n        installmentEl.textContent = new Intl.NumberFormat('en-US', {\n          style: 'currency',\n          currency: 'USD',\n          minimumFractionDigits: 2,\n          maximumFractionDigits: 2\n        }).format(installment);\n      }\n\n      updateShopPayInstallment();\n\n      var priceEl = document.querySelector('.pricerow .main-price, #price');\n      if (priceEl) {\n        new MutationObserver(updateShopPayInstallment).observe(priceEl, {\n          childList: true,\n          characterData: true,\n          subtree: true\n        });\n      }\n\n      document.addEventListener('variant:change', updateShopPayInstallment);\n      document.addEventListener('change', updateShopPayInstallment);\n    });\n  </script>\n{% endif %}\n\n<style>\n  .custom-shop-pay-line{\n    display:flex;\n    align-items:center;\n    gap:5px;\n    margin-top:-6px;\n    margin-bottom:14px;\n    font-family:inherit;\n    font-size:13px;\n    line-height:1.4;\n    color:rgba(22,22,22,.82);\n    flex-wrap:wrap;\n  }\n\n  .custom-shop-pay-line strong{\n    font-weight:700;\n    color:#161616;\n  }\n\n  .custom-shop-pay-logo{\n    height:14px;\n    width:auto;\n    display:inline-block;\n  }\n</style>"
          }
        },
