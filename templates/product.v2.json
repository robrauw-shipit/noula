\n\n  @media screen and (max-width: 390px) {\n    .nla-proof__avatar {\n      width: 24px;\n      height: 24px;\n      margin-left: -8px;\n    }\n\n    .nla-proof__row {\n      gap: 8px;\n    }\n\n    .nla-proof__copy {\n      font-size: 12px;\n      white-space: normal;\n      gap: 4px;\n    }\n\n    .nla-proof__verified {\n      width: 14px;\n      height: 14px;\n    }\n\n    .nla-proof__stars {\n      font-size: 14px;\n      letter-spacing: 0.5px;\n    }\n\n    .nla-proof__reviews {\n      font-size: 12px;\n    }\n  }\n</style>\n\n<div class=\"nla-proof\">\n  <div class=\"nla-proof__row\">\n    <div class=\"nla-proof__stack\">\n      <span class=\"nla-proof__avatar\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/Frame_47.png?v=1782106073\" alt=\"\">\n      </span>\n      <span class=\"nla-proof__avatar\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/Frame_46.png?v=1782106073\" alt=\"\">\n      </span>\n      <span class=\"nla-proof__avatar\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/Frame_48.png?v=1782106072\" alt=\"\">\n      </span>\n    </div>\n\n    <div class=\"nla-proof__copy\">\n      <span class=\"nla-proof__name\">Maria</span>\n      <img\n        class=\"nla-proof__verified\"\n        src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\"\n        alt=\"Verified\"\n      >\n      <span>and 12,000+ others purchased</span>\n    </div>\n  </div>\n\n  <div class=\"nla-proof__rating\">\n    <span class=\"nla-proof__stars\">★★★★★</span>\n    <span class=\"nla-proof__reviews\">4.8/5 (476+ reviews)</span>\n  </div>\n</div>"
