    "custom_liquid_9VELEq": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %}\n  SECTION 13 — LOVED BY + REVIEWS CAROUSEL\n  Self-contained Custom Liquid. Theme-font friendly.\n{% endcomment %}\n\n<style>\n  .noula-loved {\n    font-family: inherit;\n    color: #2D241D;\n    line-height: 1.5;\n    padding: 42px 0 12px;\n    border-top: 1px solid #EAE1D2;\n  }\n\n  .noula-loved *,\n  .noula-loved *::before,\n  .noula-loved *::after {\n    box-sizing: border-box;\n    font-family: inherit;\n  }\n\n  .noula-loved__head {\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 0 18px;\n    text-align: center;\n  }\n\n  .noula-loved__title {\n    margin: 0;\n    color: #2D241D;\n    font-size: clamp(27px, 7vw, 34px);\n    line-height: 1.12;\n    font-weight: 800;\n    letter-spacing: 0;\n  }\n\n  .noula-loved__circ {\n    position: relative;\n    display: inline-block;\n    white-space: nowrap;\n  }\n\n  .noula-loved__circ svg {\n    position: absolute;\n    left: -9px;\n    top: -5px;\n    width: calc(100% + 18px);\n    height: calc(100% + 10px);\n    overflow: visible;\n    pointer-events: none;\n  }\n\n  .noula-loved__lead {\n    margin: 11px 0 0;\n    color: #6B5C4F;\n    font-size: 14px;\n    line-height: 1.45;\n  }\n\n  .noula-revs-wrap {\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 0;\n  }\n\n  .noula-revs {\n    display: flex;\n    gap: 14px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    padding: 22px 18px 12px !important;\n    margin: 0;\n    scroll-padding-left: 18px;\n    scroll-padding-right: 18px;\n    scrollbar-width: none;\n  }\n\n  .noula-revs::-webkit-scrollbar {\n    display: none;\n  }\n\n  .noula-rev {\n    scroll-snap-align: start;\n    flex: 0 0 calc(84% - 8px);\n    max-width: 360px;\n    overflow: hidden;\n    border: 1px solid #EAE1D2;\n    border-radius: 14px;\n    background: #FFFFFF;\n    box-shadow: 0 8px 24px rgba(45, 36, 29, 0.045);\n  }\n\n  .noula-rev__img {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n    object-position: center center;\n    display: block;\n    background: #F3E8D8;\n  }\n\n  .noula-rev__body {\n    padding: 15px 16px 16px;\n  }\n\n  .noula-rev__top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n  }\n\n  .noula-rev__name {\n    color: #2D241D;\n    font-size: 16px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: 0;\n  }\n\n  .noula-rev__stars {\n    color: #D2978B;\n    letter-spacing: 1px;\n    font-size: 13px;\n    line-height: 1;\n    white-space: nowrap;\n  }\n\n  .noula-rev__verified {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-top: 11px;\n    color: #D2978B;\n    font-size: 11px;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n  }\n\n  .noula-rev__verified img {\n    width: 15px;\n    height: 15px;\n    display: block;\n    flex-shrink: 0;\n  }\n\n  .noula-rev__quote {\n    margin: 14px 0 0;\n    color: #5F5147;\n    font-size: 14px;\n    line-height: 1.55;\n  }\n\n  .noula-rev__more {\n    display: block;\n    margin-top: 18px;\n    color: #D2978B;\n    font-size: 13px;\n    line-height: 1;\n    font-weight: 800;\n    text-align: center;\n    text-decoration: none;\n  }\n\n  @media screen and (min-width: 750px) {\n    .noula-loved {\n      padding: 46px 0 18px;\n    }\n\n    .noula-loved__head {\n      padding: 0 24px;\n    }\n\n    .noula-loved__lead {\n      font-size: 15px;\n    }\n\n    .noula-revs-wrap {\n      padding: 0 32px;\n    }\n\n    .noula-revs {\n      gap: 18px;\n      padding: 26px 8px 14px !important;\n      scroll-padding-left: 8px;\n    }\n\n    .noula-rev {\n      flex: 0 0 290px;\n      max-width: 290px;\n      min-width: 0;\n    }\n\n    .noula-rev__body {\n      padding: 18px 18px 20px;\n    }\n\n    .noula-rev__name {\n      font-size: 17px;\n    }\n\n    .noula-rev__quote {\n      font-size: 14.5px;\n    }\n  }\n\n  @media screen and (min-width: 1200px) {\n    .noula-revs-wrap {\n      padding: 0 48px;\n    }\n\n    .noula-rev {\n      flex: 0 0 300px;\n      max-width: 300px;\n    }\n  }\n</style>\n\n<div class=\"noula-loved\">\n  <div class=\"noula-loved__head\">\n    <h2 class=\"noula-loved__title\">\n      Loved by\n      <span class=\"noula-loved__circ\">\n        12,000+\n        <svg viewBox=\"0 0 200 70\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n          <ellipse cx=\"100\" cy=\"35\" rx=\"95\" ry=\"30\" fill=\"none\" stroke=\"#D2978B\" stroke-width=\"2.5\" transform=\"rotate(-3 100 35)\" />\n        </svg>\n      </span>\n    </h2>\n    <p class=\"noula-loved__lead\">Real women waking up to softer, fresher-looking skin.</p>\n  </div>\n\n  <div class=\"noula-revs-wrap\">\n    <div class=\"noula-revs\">\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"{{ 'noula-selfie-3.jpg' | asset_url }}\" alt=\"Margaret, 58\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Margaret, 58</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“I'd given up on night creams. This is the first one where my skin actually feels different by morning.”</p>\n          <a class=\"noula-rev__more\" href=\"#reviews\">Read More</a>\n        </div>\n      </div>\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"{{ 'noula-selfie-1.jpg' | asset_url }}\" alt=\"Carol, 53\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Carol, 53</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“Three months in and the crepiness on my neck has softened. Nothing else had touched it.”</p>\n          <a class=\"noula-rev__more\" href=\"#reviews\">Read More</a>\n        </div>\n      </div>\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"{{ 'noula-selfie-5.jpg' | asset_url }}\" alt=\"Yvonne, 49\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Yvonne, 49</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“Retinol wrecked me last year. This doesn't sting at all and my skin still feels like something is happening.”</p>\n          <a class=\"noula-rev__more\" href=\"#reviews\">Read More</a>\n        </div>\n      </div>\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"{{ 'noula-selfie-2.jpg' | asset_url }}\" alt=\"Sunita, 51\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Sunita, 51</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“I moisturised every night and still woke up dry. Three weeks in, that stopped.”</p>\n          <a class=\"noula-rev__more\" href=\"#reviews\">Read More</a>\n        </div>\n      </div>\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"{{ 'noula-selfie-4.jpg' | asset_url }}\" alt=\"Lynn, 47\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Lynn, 47</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“Doesn't sit on my face. Nothing on the pillowcase in the morning.”</p>\n          <a class=\"noula-rev__more\" href=\"#reviews\">Read More</a>\n        </div>\n      </div>\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-01.jpg?v=1782119454\" alt=\"Maria, 43\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Maria, 43</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“My skin finally looks rested in the morning, not just moisturized.”</p>\n          <a class=\"noula-rev__more\" href=\"#reviews\">Read More</a>\n        </div>\n      </div>\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-06.jpg?v=1782119454\" alt=\"Priya, 41\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Priya, 41</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“It feels rich, but never greasy. My skin looks calmer when I wake up.”</p>\n          <a class=\"noula-rev__more\" href=\"#reviews\">Read More</a>\n        </div>\n      </div>\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-04.jpg?v=1782119454\" alt=\"Dana, 45\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Dana, 45</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“No harsh tingle. Just softer skin that looks less tired by morning.”</p>\n          <a class=\"noula-rev__more\" href=\"#reviews\">Read More</a>\n        </div>\n      </div>\n      <div class=\"noula-rev\">\n        <img class=\"noula-rev__img\" src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/noula-verified-review-02.jpg?v=1782119454\" alt=\"Elena, 44\" loading=\"lazy\">\n        <div class=\"noula-rev__body\">\n          <div class=\"noula-rev__top\">\n            <span class=\"noula-rev__name\">Elena, 44</span>\n            <span class=\"noula-rev__stars\">★★★★★</span>\n          </div>\n          <div class=\"noula-rev__verified\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0809/2925/9750/files/google-verified-1.svg?v=1782106303\" alt=\"\">\n            Verified purchase\n          </div>\n          <p class=\"noula-rev__quote\">“I wake up looking fresher, even on mornings when I feel tired.”</p>\n          <a class=\"noula-rev__more\" href=\"#reviews\">Read More</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
