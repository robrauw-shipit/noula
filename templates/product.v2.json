            "custom_liquid": "{% comment %}\n  NOULA — COMPACT GALLERY THUMBNAILS\n  One row on every breakpoint, ~50% smaller thumbs, 6 visible, inset from the\n  left edge. Overrides the theme's wrapping grid.\n{% endcomment %}\n\n<style>\n  /* tight gap under the main image */\n  #MediaGallery-{{ section.id }} .thumbnail-slider,\n  #MediaGallery-{{ section.id }} slider-component.thumbnail-slider{\n    margin-top:8px;\n  }\n\n  /* ONE ROW ALWAYS — the theme uses a wrapping grid, which is what\n     pushed the thumbs onto a second row on desktop. */\n  #MediaGallery-{{ section.id }} .thumbnail-list{\n    display:flex !important;\n    flex-wrap:nowrap !important;\n    grid-template-columns:none !important;\n    gap:8px;\n    grid-gap:8px;\n    overflow-x:auto;\n    scroll-snap-type:x mandatory;\n    -webkit-overflow-scrolling:touch;\n    scrollbar-width:none;\n    padding-left:1.5rem;\n    padding-right:1.5rem;\n    scroll-padding-left:1.5rem;\n  }\n  #MediaGallery-{{ section.id }} .thumbnail-list::-webkit-scrollbar{\n    display:none;\n  }\n\n  /* six across, so a 5-6 image product shows everything at a glance */\n  #MediaGallery-{{ section.id }} .thumbnail-list__item{\n    flex:0 0 calc((100% - 40px) / 6) !important;\n    width:auto !important;\n    max-width:none !important;\n    scroll-snap-align:start;\n  }\n\n  /* thumbs fill their tile cleanly */\n  #MediaGallery-{{ section.id }} .thumbnail{\n    border-radius:8px;\n  }\n  #MediaGallery-{{ section.id }} .thumbnail img{\n    object-fit:cover;\n    width:100%;\n    height:100%;\n  }\n\n  /* desktop: no gutter needed, keep the single row */\n  @media screen and (min-width:750px){\n    #MediaGallery-{{ section.id }} .thumbnail-list{\n      padding-left:0;\n      padding-right:0;\n      scroll-padding-left:0;\n      overflow-x:visible;\n    }\n    #MediaGallery-{{ section.id }} .thumbnail-list__item{\n      flex:0 0 calc((100% - 40px) / 6) !important;\n    }\n  }\n</style>\n"
          }
